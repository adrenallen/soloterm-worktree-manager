#!/bin/zsh
# Soloterm Worktree Manager
#
# swm runs under zsh regardless of the shell you use interactively, so bash,
# fish, and friends all invoke it the same way.
#
# This stays /bin/zsh rather than /usr/bin/env zsh because swm update in 1.7.0
# and earlier only accepts a download whose first line is exactly "#!/bin/zsh",
# and changing it would strand every one of those installs. valid_swm_script
# below now accepts either form, so this can move once 1.8+ is what is out
# there.
set -euo pipefail

SWM_VERSION="1.12.0"
SWM_REPOSITORY="adrenallen/soloterm-worktree-manager"
SWM_SOURCE_URL="https://raw.githubusercontent.com/${SWM_REPOSITORY}/main/swm"

# Resolved here because zsh rebinds $0 to the function name inside a function.
# :A also follows a symlinked install back to the real file.
SWM_SCRIPT="${0:A}"

# Styling is dropped for non-terminals, dumb terminals, and NO_COLOR, so piped
# output and scripted runs stay plain. stdout and stderr are tested separately
# because either can be redirected on its own.
swm_color_fd() {
  [[ -z "${NO_COLOR:-}" ]] || return 1
  [[ "${TERM:-dumb}" != "dumb" ]] || return 1
  [[ -t "$1" ]]
}

if swm_color_fd 1; then
  B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'
  RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'
  MAG=$'\e[35m'; CYN=$'\e[36m'
else
  B="" D="" R="" RED="" GRN="" YLW="" MAG="" CYN=""
fi

if swm_color_fd 2; then
  ERED=$'\e[31m'; EDIM=$'\e[2m'; ER=$'\e[0m'
else
  ERED="" EDIM="" ER=""
fi

# Ticks, arrows, and box drawing are only legible on a UTF-8 locale; anywhere
# else they arrive as mojibake, so fall back to ASCII that means the same thing.
swm_unicode() {
  local charset="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
  [[ "${charset:l}" == *utf-8* || "${charset:l}" == *utf8* ]]
}

# OSC 8 turns text into a clickable link. Terminals that do not understand the
# sequence are meant to discard it, but older ones and multiplexers print it as
# rubbish instead, so this is an allowlist of terminals known to handle it
# rather than a guess. SWM_HYPERLINKS forces the answer either way.
hyperlinks_supported() {
  case "${SWM_HYPERLINKS:-}" in
    1|yes|true|always) return 0 ;;
    0|no|false|never)  return 1 ;;
  esac

  [[ -t 1 ]] || return 1
  [[ "${TERM:-dumb}" != "dumb" ]] || return 1

  # A multiplexer sits between swm and the real terminal and may not pass the
  # sequence through, and there is no way from here to ask whether it will.
  [[ -z "${TMUX:-}" ]] || return 1
  [[ "${TERM}" != screen* && "${TERM}" != tmux* ]] || return 1

  case "${TERM_PROGRAM:-}" in
    ghostty|iTerm.app|WezTerm|vscode|Hyper|rio|Tabby) return 0 ;;
    Apple_Terminal) return 1 ;;
  esac

  case "${TERM}" in
    xterm-ghostty|xterm-kitty) return 0 ;;
  esac

  [[ -z "${KITTY_WINDOW_ID:-}" ]] || return 0
  [[ -z "${WEZTERM_PANE:-}" ]] || return 0
  [[ -z "${WT_SESSION:-}" ]] || return 0
  # VTE gained OSC 8 in 0.50, which reports as 5000.
  [[ "${VTE_VERSION:-}" == <-> ]] && (( VTE_VERSION >= 5000 )) && return 0

  return 1
}

# Decided once, here, because hyperlink() is called from inside command
# substitutions where stdout is a pipe: asking "is stdout a terminal" there
# would answer no every time and silently drop every link.
if hyperlinks_supported; then
  LINKS=1
else
  LINKS=""
fi

# Wrap text in an OSC 8 hyperlink, or return it untouched where links would not
# survive. Callers pad the text to width first, so the escapes never take part
# in column alignment.
hyperlink() {
  local url="$1" text="$2"

  if [[ -z "$url" || -z "$LINKS" ]]; then
    print -r -- "$text"
    return 0
  fi

  print -r -- $'\e]8;;'"${url}"$'\e\\'"${text}"$'\e]8;;\e\\'
}

if swm_unicode; then
  MARK_OK="✓"; MARK_BAD="✗"; MARK_WARN="!"; MARK_ARROW="▸"
  MARK_TO="→"; DOT="·"; EM="—"
else
  MARK_OK="+"; MARK_BAD="x"; MARK_WARN="!"; MARK_ARROW=">"
  MARK_TO="->"; DOT="-"; EM="-"
fi

# Prefer the zsh on PATH, but keep working when swm was invoked by absolute
# path from an environment that does not expose one.
zsh_interpreter() {
  if [[ -n "${commands[zsh]:-}" ]]; then
    print -r -- "${commands[zsh]}"
  elif [[ -x /bin/zsh ]]; then
    print -r -- "/bin/zsh"
  else
    return 1
  fi
}

# BSD (macOS) and GNU coreutils spell the permission-bits format differently,
# and each rejects the other's flag, so trying both covers either system.
file_mode() {
  stat -f '%Lp' -- "$1" 2>/dev/null || stat -c '%a' -- "$1" 2>/dev/null
}

has_jq() {
  command -v jq >/dev/null
}

has_zselect() {
  zmodload -e zsh/zselect || zmodload zsh/zselect 2>/dev/null
}

# Pausing must never be what ends a run. These pauses sit between destructive
# steps, so aborting on a missing or failing sleep would leave exactly the
# half-finished state they exist to prevent. zselect is a zsh module and needs
# no external binary; sleep is the fallback, and neither is allowed to fail.
swm_sleep() {
  if has_zselect; then
    zselect -t $(( $1 * 100 )) 2>/dev/null || true
    return 0
  fi

  command sleep "$1" 2>/dev/null || true
  return 0
}

# Animation needs a sub-second pause that reliably pauses. Without zselect a
# failed fractional sleep would spin the frame loop at full speed, so its
# absence turns the animation off rather than risking a busy loop.
swm_can_animate() {
  [[ -t 1 ]] || return 1
  [[ "${TERM:-dumb}" != "dumb" ]] || return 1
  has_zselect
}

# Set by with_spinner to the finished command's combined output.
SPIN_OUTPUT=""

# Run a command while showing an animated line, and return its exit status.
# Removing a worktree means stopping Solo's processes and deleting tens of
# thousands of files, which is many silent seconds; without this it reads as a
# hang. Output is captured and left in SPIN_OUTPUT so it cannot interleave with
# the animation, and the elapsed count makes a slow step visibly still moving.
with_spinner() {
  local message="$1"
  shift

  if ! swm_can_animate; then
    SPIN_OUTPUT="$("$@" 2>&1)"
    return $?
  fi

  local -a frames
  if swm_unicode; then
    frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  else
    frames=('|' '/' '-' '\')
  fi

  local captured=""
  if ! captured="$(mktemp "${TMPDIR:-/tmp}/swm-spin.XXXXXX")"; then
    SPIN_OUTPUT="$("$@" 2>&1)"
    return $?
  fi

  "$@" >"$captured" 2>&1 &
  local job=$!

  local -i frame=0
  local -i started=$SECONDS
  local -i elapsed=0
  local age=""

  while kill -0 "$job" 2>/dev/null; do
    elapsed=$(( SECONDS - started ))
    # Only worth showing once a step has lasted long enough to worry about.
    if (( elapsed >= 3 )); then
      age=" ${D}(${elapsed}s)${R}"
    fi
    printf "\r  %s%s%s %s%s" \
      "$CYN" "${frames[$(( frame % ${#frames} + 1 ))]}" "$R" "$message" "$age"
    (( ++frame ))

    # zselect reports a non-zero status when its timeout expires, which is the
    # normal outcome for a pure pause and says nothing about whether it worked.
    zselect -t 8 2>/dev/null || true

    # Belt and braces: if the pause is somehow not pausing, stop drawing rather
    # than spin a core for the length of the deletion.
    if (( frame > 200 && SECONDS == started )); then
      break
    fi
  done

  # Not named "status": zsh makes that read-only, and a local one aborts.
  local -i command_status=0
  wait "$job" || command_status=$?

  # Wipe the line so the result prints into clean space.
  printf "\r\e[2K"

  SPIN_OUTPUT="$(<"$captured")"
  rm -f -- "$captured"
  return $command_status
}

# Shorten $HOME for display only. Every path swm acts on stays absolute.
tilde() {
  print -r -- "${1/#$HOME/~}"
}

# Decorative header for the interactive entry points. Skipped when output is not
# a terminal, and on dumb terminals that cannot be trusted with box drawing, so
# pipes and logs stay clean. Returns non-zero when nothing was printed so
# callers can fall back to a plain title. NO_COLOR still shows it, uncoloured,
# since that asks for no colour rather than no interface.
banner() {
  [[ -t 1 ]] || return 1
  [[ "${TERM:-dumb}" != "dumb" ]] || return 1

  print
  if ! swm_unicode; then
    # A compact title beats box drawing rendered as mojibake.
    print -r -- "  ${CYN}${B}swm${R}  ${D}worktrees, tidied - ${SWM_VERSION}${R}"
    return 0
  fi

  print -r -- "  ${CYN}┏━┓╻ ╻┏┳┓${R}"
  print -r -- "  ${CYN}┗━┓┃╻┃┃┃┃${R}  ${D}worktrees, tidied ${DOT} ${SWM_VERSION}${R}"
  print -r -- "  ${CYN}┗━┛┗┻┛╹ ╹${R}"
}

section() {
  print -r -- "${B}$1${R}"
}

ok() {
  print -r -- "  ${GRN}${B}${MARK_OK}${R} ${B}$1${R}"
}

info() {
  print -r -- "  ${CYN}${B}${MARK_ARROW}${R} ${B}$1${R}"
}

# Aligned label/value row used by every summary block.
field() {
  printf "  %s%-8s%s %s\n" "$D" "$1" "$R" "$2"
}

hint() {
  print -r -- "${D}$1${R}"
}

fail() {
  print -u2 -r -- "${ERED}${MARK_BAD}${ER} $1"
}

detail() {
  print -u2 -r -- "  ${EDIM}$1${ER}"
}

usage() {
  print -u2 "Usage: swm"
  print -u2 "       swm [--with-env|--no-env] <worktree-name> <branch-from> [repository]"
  print -u2 "       swm new [repository]"
  print -u2 "       swm manage [repository]"
  print -u2 "       swm add [path]"
  print -u2 "       swm remove <worktree-name> [--yes]"
  print -u2 "       swm forget [repository]"
  print -u2 "       swm health [--fix]"
  print -u2 "       swm update [--force]"
  print -u2 "       swm version"
  print -u2 "       swm help"
  print -u2 "Example: swm billing-redesign dev"
  print -u2 "Example: swm billing-redesign dev --with-env"
  print -u2 "Example: swm billing-redesign main /path/to/repository"
  print -u2 "Example: swm remove billing-redesign"
  print -u2 "Run swm with no arguments for manage mode."
}

