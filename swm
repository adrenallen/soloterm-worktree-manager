#!/bin/zsh
# Soloterm Worktree Manager
set -euo pipefail

SWM_VERSION="1.2.0"
SWM_REPOSITORY="adrenallen/soloterm-worktree-manager"
SWM_SOURCE_URL="https://raw.githubusercontent.com/${SWM_REPOSITORY}/main/swm"

# Resolved here because zsh rebinds $0 to the function name inside a function.
# :A also follows a symlinked install back to the real file.
SWM_SCRIPT="${0:A}"

usage() {
  print -u2 "Usage: swm"
  print -u2 "       swm [--with-env] <worktree-name> <branch-from> [repository]"
  print -u2 "       swm manage [repository]"
  print -u2 "       swm remove <worktree-name> [--yes]"
  print -u2 "       swm forget [repository]"
  print -u2 "       swm update [--force]"
  print -u2 "       swm version"
  print -u2 "       swm help"
  print -u2 "Example: swm billing-redesign dev"
  print -u2 "Example: swm billing-redesign dev --with-env"
  print -u2 "Example: swm billing-redesign main /path/to/repository"
  print -u2 "Example: swm remove billing-redesign"
  print -u2 "Run swm with no arguments for manage mode."
}

help_page() {
  print -r -- "Soloterm Worktree Manager — manage Git worktrees in Solo and Laravel Herd"
  print
  print -r -- "CREATE"
  print -r -- "  swm <worktree-name> <branch-from> [repository] [--with-env]"
  print
  print -r -- "  <worktree-name> becomes the new Git branch name. Its DNS-safe form"
  print -r -- "  becomes the folder name, and the Herd site name when Herd is present."
  print
  print -r -- "  <branch-from> may be a branch, tag, commit, or explicit ref. Simple"
  print -r -- "  branch names such as main or dev refresh and prefer origin/<name>."
  print
  print -r -- "  [repository] defaults to the Git repository containing the current"
  print -r -- "  directory."
  print
  print -r -- "MANAGE"
  print -r -- "  swm"
  print -r -- "  swm manage [repository]"
  print
  print -r -- "  Show an interactive list of the repository's current worktrees. Pick"
  print -r -- "  one to fork its exact HEAD into a new managed worktree, optionally"
  print -r -- "  copying its .env, or remove a worktree managed under SWM_ROOT."
  print -r -- "  Main and externally managed worktrees can be forked but not removed."
  print
  print -r -- "OPTIONS"
  print -r -- "  --with-env"
  print -r -- "      Copy the source repository's ignored .env into the new worktree."
  print -r -- "      APP_NAME is set to the worktree site name. With Herd installed,"
  print -r -- "      APP_URL is also set to the generated local URL; without Herd the"
  print -r -- "      copied APP_URL is left unchanged. Tracked or non-ignored .env"
  print -r -- "      files are refused."
  print
  print -r -- "REMOVE"
  print -r -- "  swm remove <worktree-name>"
  print -r -- "  swm rm <worktree-name> --yes"
  print
  print -r -- "  Stops and removes the matching Solo project, then removes the linked"
  print -r -- "  Git worktree. Dirty worktrees can be reviewed before choosing to cancel"
  print -r -- "  or force deletion with a typed-name confirmation. The Git branch is"
  print -r -- "  preserved. --yes skips only the normal clean-worktree confirmation."
  print
  print -r -- "PROJECT DEFAULTS"
  print -r -- "  swm forget [repository]"
  print -r -- ""
  print -r -- "  The first time you fork a worktree whose source has a .env, swm"
  print -r -- "  asks whether to copy it, then offers to remember the answer for"
  print -r -- "  that project. Later forks apply the remembered answer without"
  print -r -- "  asking. swm forget clears it so the prompt returns."
  print -r -- ""
  print -r -- "  Defaults are keyed by the project's main worktree and stored in"
  print -r -- "  \$XDG_CONFIG_HOME/swm/projects.conf (default ~/.config/swm)."
  print -r -- "  They apply to fork mode only; direct creation still requires an"
  print -r -- "  explicit --with-env."
  print
  print -r -- "UPDATE"
  print -r -- "  swm update [--force]"
  print -r -- "  swm version"
  print -r -- ""
  print -r -- "  Download the latest swm and replace the installed script in"
  print -r -- "  place. The download is rejected unless it parses as a valid swm."
  print -r -- "  Package-manager installs are refused, and a Git checkout is"
  print -r -- "  refused unless --force is given. --force also reinstalls the"
  print -r -- "  current version."
  print -r -- ""
  print -r -- "  Separately, swm checks for a newer version every two days and"
  print -r -- "  prints a one-line notice. The check runs in the background and"
  print -r -- "  reports from a cache, so it never delays a command."
  print
  print -r -- "PATHS"
  print -r -- "  With Herd:    \$HOME/Herd/<site-name>"
  print -r -- "  Without Herd: \$HOME/worktrees/<site-name>"
  print -r -- "  Override the root with: SWM_ROOT=/another/path"
  print
  print -r -- "ENVIRONMENT"
  print -r -- "  SWM_ROOT                     Worktree root directory."
  print -r -- "  SWM_NO_UPDATE_CHECK=1        Disable the periodic update check."
  print -r -- "  SWM_UPDATE_CHECK_INTERVAL    Seconds between checks (default 172800)."
  print
  print -r -- "EXAMPLES"
  print -r -- "  swm checkout-redesign dev --with-env"
  print -r -- "  swm api-fix main /path/to/project"
  print -r -- "  swm manage"
  print -r -- "  swm remove checkout-redesign"
  print -r -- "  swm update"
  print
  print -r -- "REQUIREMENTS"
  print -r -- "  macOS, Zsh, Git, jq, Solo, and Solo's local HTTP API."
  print -r -- "  Laravel Herd is optional. When installed, worktrees are parked and"
  print -r -- "  served at http://<site-name>.<tld>."
}

site_slug() {
  print -r -- "$1" \
    | tr '[:upper:]_/' '[:lower:]--' \
    | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-//; s/-$//'
}

update_cache_file() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/swm/update-check"
}

# Read the version out of a swm script without executing any of it.
script_version() {
  sed -n -E 's/^SWM_VERSION="([^"]+)"$/\1/p' "$1" | head -1
}

download_swm() {
  curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 \
    --max-time 20 -o "$1" -- "$SWM_SOURCE_URL"
}

# Guard against a truncated download, an HTML error page, or anything else that
# is not a runnable swm. This is an integrity check, not an authenticity one.
valid_swm_script() {
  local candidate="$1"
  [[ -s "$candidate" ]] || return 1
  [[ "$(head -1 -- "$candidate")" == "#!/bin/zsh" ]] || return 1
  [[ -n "$(script_version "$candidate")" ]] || return 1
  zsh -n "$candidate" 2>/dev/null || return 1
}

update_swm() {
  local force="${1:-}"

  if [[ -n "$force" && "$force" != "--force" ]]; then
    print -u2 "Unknown option: $force"
    print -u2 "Usage: swm update [--force]"
    return 2
  fi

  if ! command -v curl >/dev/null; then
    print -u2 "curl is required to update swm."
    return 1
  fi

  local target="$SWM_SCRIPT"
  if [[ ! -f "$target" ]]; then
    print -u2 "Cannot locate the running swm script to update."
    return 1
  fi

  local target_directory="${target:h}"

  case "$target" in
    /opt/homebrew/*|/usr/local/Cellar/*|/nix/store/*|/opt/local/*)
      print -u2 "swm appears to be installed by a package manager:"
      print -u2 "  $target"
      print -u2 "Update it with that package manager instead."
      return 1
      ;;
  esac

  # A checkout is someone's working copy of swm itself; overwriting it would
  # silently discard their edits.
  if [[ "$force" != "--force" ]] \
    && git -C "$target_directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -u2 "swm is running from a Git checkout:"
    print -u2 "  $target"
    print -u2 "Use git to update it, or re-run with --force to overwrite."
    return 1
  fi

  if [[ ! -w "$target" || ! -w "$target_directory" ]]; then
    print -u2 "No write permission for the installed script:"
    print -u2 "  $target"
    return 1
  fi

  print "Checking $SWM_REPOSITORY for updates…"

  # Stage the download beside the target so the replacement below is a
  # same-filesystem rename rather than a cross-device copy.
  local staged="$(mktemp "${target_directory}/.swm-update.XXXXXX")"

  if ! download_swm "$staged"; then
    rm -f -- "$staged"
    print -u2 "Could not download the latest swm from $SWM_SOURCE_URL"
    return 1
  fi

  if ! valid_swm_script "$staged"; then
    rm -f -- "$staged"
    print -u2 "The downloaded file is not a valid swm script; nothing was changed."
    return 1
  fi

  local latest="$(script_version "$staged")"

  autoload -Uz is-at-least
  if [[ "$force" != "--force" ]] && is-at-least "$latest" "$SWM_VERSION"; then
    rm -f -- "$staged"
    print "Already up to date (swm $SWM_VERSION)."
    return 0
  fi

  if ! chmod "$(stat -f '%Lp' "$target")" "$staged"; then
    rm -f -- "$staged"
    print -u2 "Could not set permissions on the downloaded script."
    return 1
  fi

  # Renaming swaps the directory entry and leaves this running script's inode
  # intact, so the in-flight process keeps reading the old file safely.
  if ! mv -f -- "$staged" "$target"; then
    rm -f -- "$staged"
    print -u2 "Could not replace $target"
    return 1
  fi

  # Keep the notice from advertising a version that is now installed.
  rm -f -- "$(update_cache_file)"

  print "Updated swm $SWM_VERSION → $latest"
  print "  $target"
}

# Refresh the cached latest-version marker without blocking this run. The
# timestamp is recorded even when the download fails so an offline machine
# backs off for the full interval instead of retrying on every invocation.
refresh_update_cache() {
  local cache_file="$1" now="$2" previous_version="$3"
  local cache_directory="${cache_file:h}"

  {
    mkdir -p -- "$cache_directory" || exit 0

    local staged="" latest="$previous_version" staged_cache=""
    staged="$(mktemp "${TMPDIR:-/tmp}/swm-check.XXXXXX")" || exit 0

    if download_swm "$staged" && valid_swm_script "$staged"; then
      latest="$(script_version "$staged")"
      [[ -n "$latest" ]] || latest="$previous_version"
    fi
    rm -f -- "$staged"

    staged_cache="$(mktemp "${cache_directory}/staged.XXXXXX")" || exit 0
    print -r -- "$now" > "$staged_cache"
    print -r -- "$latest" >> "$staged_cache"
    mv -f -- "$staged_cache" "$cache_file"
  } >/dev/null 2>&1 &!
}

# Report from the cached result so no run ever waits on the network, then kick
# off a background refresh when the interval has elapsed.
check_for_update() {
  [[ -z "${SWM_NO_UPDATE_CHECK:-}" ]] || return 0
  command -v curl >/dev/null || return 0

  local cache_file="$(update_cache_file)"
  local interval="${SWM_UPDATE_CHECK_INTERVAL:-172800}"
  local now="$(date +%s)"
  local checked_at=0
  local cached_version=""

  if [[ -f "$cache_file" ]]; then
    local -a cache_lines
    cache_lines=("${(@f)$(<"$cache_file")}")
    checked_at="${cache_lines[1]:-0}"
    cached_version="${cache_lines[2]:-}"
    [[ "$checked_at" == <-> ]] || checked_at=0
  fi

  if [[ -n "$cached_version" ]]; then
    autoload -Uz is-at-least
    if ! is-at-least "$cached_version" "$SWM_VERSION"; then
      print -u2 "swm $cached_version is available (installed: $SWM_VERSION). Run: swm update"
      print -u2
    fi
  fi

  if (( now - checked_at >= interval )); then
    refresh_update_cache "$cache_file" "$now" "$cached_version"
  fi
}

project_defaults_file() {
  print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/swm/projects.conf"
}

# Identify a project by its main worktree, so every linked worktree of the same
# clone resolves to one key.
main_worktree_path() {
  local first="$(
    git -C "$1" worktree list --porcelain | sed -n '1s/^worktree //p'
  )"
  [[ -n "$first" ]] || return 1
  print -r -- "${first:A}"
}

# Entries are "<setting>=<value><TAB><project path>". Splitting on the first tab
# keeps the path intact even in the unlikely case that it contains one.
project_default() {
  local project_path="$1" setting="$2"
  local file="$(project_defaults_file)"
  [[ -f "$file" ]] || return 1

  local line entry stored_path
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != '#'* && "$line" == *$'\t'* ]] || continue
    entry="${line%%$'\t'*}"
    stored_path="${line#*$'\t'}"
    [[ "$stored_path" == "$project_path" && "${entry%%=*}" == "$setting" ]] \
      || continue
    print -r -- "${entry#*=}"
    return 0
  done < "$file"

  return 1
}

set_project_default() {
  local project_path="$1" setting="$2" value="$3"
  local file="$(project_defaults_file)"
  local directory="${file:h}"

  mkdir -p -- "$directory" || return 1
  local staged=""
  staged="$(mktemp "${directory}/.projects.XXXXXX")" || return 1

  {
    print -r -- "# swm project defaults"
    if [[ -f "$file" ]]; then
      local line entry stored_path
      while IFS= read -r line; do
        [[ -n "$line" && "$line" != '#'* ]] || continue
        if [[ "$line" == *$'\t'* ]]; then
          entry="${line%%$'\t'*}"
          stored_path="${line#*$'\t'}"
          # Drop any previous value for this project and setting.
          if [[ "$stored_path" == "$project_path" \
            && "${entry%%=*}" == "$setting" ]]; then
            continue
          fi
        fi
        print -r -- "$line"
      done < "$file"
    fi
    # An empty value removes the entry, so this block must still exit zero.
    if [[ -n "$value" ]]; then
      print -r -- "${setting}=${value}"$'\t'"${project_path}"
    fi
  } >> "$staged" || { rm -f -- "$staged"; return 1; }

  mv -f -- "$staged" "$file" || { rm -f -- "$staged"; return 1; }
}

forget_project_defaults() {
  local repo_input="${1:-.}"
  local repo=""

  if ! repo="$(git -C "$repo_input" rev-parse --show-toplevel 2>/dev/null)"; then
    print -u2 "swm forget must run inside a Git repository, or receive one:"
    print -u2 "  swm forget /path/to/repository"
    return 1
  fi

  local project_path=""
  if ! project_path="$(main_worktree_path "$repo")"; then
    print -u2 "Could not determine the main worktree for: $repo"
    return 1
  fi

  local current=""
  if ! current="$(project_default "$project_path" "fork-env")"; then
    print "No remembered defaults for ${project_path:t}."
    print "  $project_path"
    return 0
  fi

  if ! set_project_default "$project_path" "fork-env" ""; then
    print -u2 "Could not update $(project_defaults_file)"
    return 1
  fi

  print "Forgot the .env fork default (was: $current) for ${project_path:t}."
  print "  $project_path"
}

has_herd() {
  command -v herd >/dev/null
}

# Herd users keep the parked $HOME/Herd default. Without Herd, fall back to a
# neutral directory, but keep using an existing $HOME/Herd so worktrees created
# while Herd was installed stay visible after it is removed.
default_worktree_root() {
  if [[ -n "${SWM_ROOT:-}" ]]; then
    print -r -- "$SWM_ROOT"
  elif has_herd || [[ -d "$HOME/Herd" ]]; then
    print -r -- "$HOME/Herd"
  else
    print -r -- "$HOME/worktrees"
  fi
}

repository_name() {
  local repo_path="$1"
  local common_git_dir="$(
    cd "$repo_path"
    cd "$(git rev-parse --git-common-dir)"
    pwd -P
  )"

  if [[ "${common_git_dir:t}" == ".git" ]]; then
    print -r -- "${common_git_dir:h:t}"
  else
    print -r -- "${repo_path:t}"
  fi
}

set_env_value() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  local original_mode="$(stat -f '%Lp' "$env_file")"
  local temp_root="${TMPDIR:-/tmp}"
  local temp_file="$(mktemp "${temp_root%/}/swm-env.XXXXXX")"

  if ! awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    $0 ~ ("^" key "=") {
      if (!found) {
        print key "=" value
        found = 1
      }
      next
    }
    { print }
    END {
      if (!found) {
        print key "=" value
      }
    }
  ' "$env_file" > "$temp_file"; then
    rm -f -- "$temp_file"
    return 1
  fi

  if ! chmod "$original_mode" "$temp_file"; then
    rm -f -- "$temp_file"
    return 1
  fi

  if ! mv -f -- "$temp_file" "$env_file"; then
    rm -f -- "$temp_file"
    return 1
  fi
}

remove_worktree() {
  local requested_name="${1:-}"
  local confirmation_flag="${2:-}"
  local worktree_root="$(default_worktree_root)"

  if [[ -z "$requested_name" ]]; then
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    return 2
  fi

  if [[ -n "$confirmation_flag" && "$confirmation_flag" != "--yes" ]]; then
    print -u2 "Unknown option: $confirmation_flag"
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    return 2
  fi

  local site_name="$(site_slug "$requested_name")"
  if [[ -z "$site_name" || ${#site_name} -gt 63 ]]; then
    print -u2 "Invalid worktree name: $requested_name"
    return 1
  fi

  local canonical_root="${worktree_root:A}"
  local worktree_path="${canonical_root}/${site_name}"

  solo status >/dev/null

  if ! command -v jq >/dev/null; then
    print -u2 "jq is required to find the matching Solo project."
    return 1
  fi

  local projects_json="$(solo projects list --json)"
  local project_ids=("${(@f)$(
    print -r -- "$projects_json" \
      | jq -r --arg path "$worktree_path" \
          '.data.projects[] | select((.path | rtrimstr("/")) == $path) | .id'
  )}")
  local project_id=""

  # An empty command substitution becomes one empty array item in zsh.
  if (( ${#project_ids} == 1 )) && [[ -z "${project_ids[1]}" ]]; then
    project_ids=()
  fi

  if (( ${#project_ids} > 1 )); then
    print -u2 "Multiple Solo projects unexpectedly match: $worktree_path"
    return 1
  elif (( ${#project_ids} == 1 )); then
    project_id="${project_ids[1]}"
  fi

  local branch_name=""
  local common_git_dir=""
  local delete_dirty=false

  if [[ -e "$worktree_path" ]]; then
    if [[ ! -d "$worktree_path" || ! -f "$worktree_path/.git" ]]; then
      print -u2 "Refusing to remove a path that is not a linked Git worktree:"
      print -u2 "  $worktree_path"
      return 1
    fi

    local actual_top="$(
      git -C "$worktree_path" rev-parse --show-toplevel 2>/dev/null
    )"
    actual_top="${actual_top:A}"

    if [[ "$actual_top" != "$worktree_path" ]]; then
      print -u2 "Refusing to remove an unexpected Git directory:"
      print -u2 "  $worktree_path"
      return 1
    fi

    local dirty_state="$(
      git -C "$worktree_path" status --porcelain --untracked-files=all
    )"
    if [[ -n "$dirty_state" ]]; then
      local -a dirty_files
      dirty_files=("${(@f)dirty_state}")
      print -u2 "Worktree has ${#dirty_files} uncommitted or untracked file(s)."
      print -u2 -- "--yes does not override this safety check."

      while true; do
        local dirty_action=""
        if ! read "dirty_action?Action: [s]how files, [d]elete anyway, [c]ancel: "; then
          print "Cancelled."
          return 0
        fi

        case "${dirty_action:l}" in
          s|show|files|"show files"|"show me the files")
            print
            git -C "$worktree_path" status --short --branch --untracked-files=all
            print
            ;;
          d|delete|force|"delete anyway")
            print
            print -u2 "Warning: this permanently deletes these local changes."
            local typed_name=""
            if ! read "typed_name?Type '$site_name' to confirm: "; then
              print "Cancelled."
              return 0
            fi

            if [[ "$typed_name" != "$site_name" ]]; then
              print "Confirmation did not match. Cancelled."
              return 0
            fi

            delete_dirty=true
            break
            ;;
          c|cancel|q|quit|"")
            print "Cancelled."
            return 0
            ;;
          *)
            print -u2 "Choose show, delete anyway, or cancel."
            ;;
        esac
      done
    fi

    branch_name="$(
      git -C "$worktree_path" symbolic-ref --quiet --short HEAD \
        2>/dev/null || print -r -- "(detached HEAD)"
    )"

    common_git_dir="$(
      cd "$worktree_path"
      cd "$(git rev-parse --git-common-dir)"
      pwd -P
    )"
  elif [[ -z "$project_id" ]]; then
    print -u2 "No managed worktree or Solo project found for: $requested_name"
    return 1
  fi

  print "Cleanup target:"
  print "  Path:    $worktree_path"
  [[ -n "$branch_name" ]] && print "  Branch:  $branch_name (branch will be kept)"
  if [[ -n "$project_id" ]]; then
    print "  Solo:    project $project_id"
  else
    print "  Solo:    already removed"
  fi

  if [[ "$confirmation_flag" != "--yes" && "$delete_dirty" != true ]]; then
    local answer=""
    read "answer?Remove this worktree folder and its Solo project? [y/N]: "
    if [[ "${answer:l}" != "y" && "${answer:l}" != "yes" ]]; then
      print "Cancelled."
      return 0
    fi
  fi

  # Stop Solo-managed processes before removing the directory they use.
  if [[ -n "$project_id" ]]; then
    solo projects delete "$project_id" --confirm-stop-running
  fi

  if [[ -e "$worktree_path" ]]; then
    # Path checks plus the confirmations above make --force safe here, while
    # still allowing expected ignored files such as .env to be removed.
    if ! git --git-dir="$common_git_dir" worktree remove --force "$worktree_path"; then
      print -u2 "Solo was removed, but Git could not remove the worktree."
      print -u2 "Resolve the Git error, then run this command again."
      return 1
    fi
  fi

  print
  print "Cleanup complete:"
  print "  Removed: $worktree_path"
  [[ -n "$branch_name" ]] && print "  Kept branch: $branch_name"
}

manage_worktrees() {
  local repo_input="${1:-.}"
  local repo=""

  if ! repo="$(git -C "$repo_input" rev-parse --show-toplevel 2>/dev/null)"; then
    print -u2 "swm manage must run inside a Git repository, or receive one:"
    print -u2 "  swm manage /path/to/repository"
    return 1
  fi

  if ! command -v jq >/dev/null; then
    print -u2 "jq is required for manage mode."
    return 1
  fi

  solo status >/dev/null

  local projects_json="$(solo projects list --json)"
  local worktree_root="$(default_worktree_root)"
  local canonical_root="${worktree_root:A}"
  local -a worktree_paths worktree_heads worktree_branches worktree_kinds
  worktree_paths=()
  worktree_heads=()
  worktree_branches=()
  worktree_kinds=()

  local token=""
  local current_path=""
  local current_head=""
  local current_branch=""

  while IFS= read -r -d $'\0' token; do
    case "$token" in
      "worktree "*)
        current_path="${token#worktree }"
        ;;
      "HEAD "*)
        current_head="${token#HEAD }"
        ;;
      "branch refs/heads/"*)
        current_branch="${token#branch refs/heads/}"
        ;;
      "detached")
        current_branch="(detached)"
        ;;
      "")
        if [[ -n "$current_path" ]]; then
          worktree_paths+=("${current_path:A}")
          worktree_heads+=("$current_head")
          worktree_branches+=("${current_branch:-"(unknown)"}")
        fi
        current_path=""
        current_head=""
        current_branch=""
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain -z)

  if (( ${#worktree_paths} == 0 )); then
    print -u2 "No worktrees found."
    return 1
  fi

  local main_path="${worktree_paths[1]}"
  local index=0
  local actual_path=""
  local kind=""
  local solo_label=""
  local short_head=""

  print "Worktrees for ${main_path:t}:"
  print
  printf "  %2s  %-28s  %-8s  %-6s  %s\n" "#" "BRANCH" "TYPE" "SOLO" "PATH"

  for (( index = 1; index <= ${#worktree_paths}; ++index )); do
    actual_path="${worktree_paths[$index]}"

    if [[ "$actual_path" == "$main_path" ]]; then
      kind="main"
    elif [[ "$actual_path" == "$canonical_root"/* ]]; then
      kind="managed"
    else
      kind="external"
    fi
    worktree_kinds+=("$kind")

    if print -r -- "$projects_json" \
      | jq -e --arg path "$actual_path" \
          '.data.projects[] | select((.path | rtrimstr("/")) == $path)' \
          >/dev/null; then
      solo_label="yes"
    else
      solo_label="no"
    fi

    short_head="${worktree_heads[$index]:0:8}"
    if [[ "${worktree_branches[$index]}" == "(detached)" ]]; then
      worktree_branches[$index]="detached@$short_head"
    fi

    printf "  %2d) %-28s  %-8s  %-6s  %s\n" \
      "$index" \
      "${worktree_branches[$index]}" \
      "$kind" \
      "$solo_label" \
      "$actual_path"
  done

  print
  local selection=""
  read "selection?Select a worktree [1-${#worktree_paths}, q]: "
  if [[ "${selection:l}" == "q" || -z "$selection" ]]; then
    print "Cancelled."
    return 0
  fi

  if [[ "$selection" != <-> ]]; then
    print -u2 "Invalid selection: $selection"
    return 2
  fi

  local selected_index=$(( 10#$selection ))
  if (( selected_index < 1 || selected_index > ${#worktree_paths} )); then
    print -u2 "Selection is out of range: $selection"
    return 2
  fi

  local selected_path="${worktree_paths[$selected_index]}"
  local selected_head="${worktree_heads[$selected_index]}"
  local selected_branch="${worktree_branches[$selected_index]}"
  local selected_kind="${worktree_kinds[$selected_index]}"

  print
  print "Selected: $selected_branch"
  print "  $selected_path"
  print
  local action=""
  read "action?Action: [f]ork into a new worktree, [r]emove, [q]uit: "

  case "${action:l}" in
    f|fork)
      local new_name=""
      read "new_name?New worktree / branch name: "
      if [[ -z "$new_name" ]]; then
        print -u2 "A new worktree name is required."
        return 2
      fi

      local -a create_command
      create_command=("$new_name" "$selected_head" "$selected_path")

      if [[ -f "$selected_path/.env" ]]; then
        local remembered=""

        if remembered="$(project_default "$main_path" "fork-env")"; then
          if [[ "$remembered" == "yes" ]]; then
            create_command+=("--with-env")
            print "Copying .env (remembered for ${main_path:t})."
          else
            print "Not copying .env (remembered for ${main_path:t})."
          fi
          print "Undo with: swm forget"
        else
          local copy_env=""
          local wants_env="no"
          read "copy_env?Copy .env and update it for the new worktree? [y/N]: "
          if [[ "${copy_env:l}" == "y" || "${copy_env:l}" == "yes" ]]; then
            create_command+=("--with-env")
            wants_env="yes"
          fi

          local remember=""
          read "remember?Remember this for ${main_path:t} from now on? [y/N]: "
          if [[ "${remember:l}" == "y" || "${remember:l}" == "yes" ]]; then
            if set_project_default "$main_path" "fork-env" "$wants_env"; then
              print "Saved. Undo with: swm forget"
            else
              print -u2 "Warning: could not save to $(project_defaults_file)"
            fi
          fi
        fi
      fi

      print
      local swm_executable="${commands[swm]:-$SWM_SCRIPT}"
      # This run already reported any available update.
      SWM_NO_UPDATE_CHECK=1 "$swm_executable" "${create_command[@]}"
      ;;
    r|remove)
      if [[ "$selected_kind" != "managed" ]]; then
        print -u2 "Only worktrees directly managed under $canonical_root can be removed."
        print -u2 "This '$selected_kind' worktree may still be used as a fork source."
        return 1
      fi

      remove_worktree "${selected_path:t}" ""
      ;;
    q|quit|"")
      print "Cancelled."
      ;;
    *)
      print -u2 "Unknown action: $action"
      return 2
      ;;
  esac
}

if [[ "${1:-}" == "version" || "${1:-}" == "-v" || "${1:-}" == "--version" ]]; then
  print -r -- "swm $SWM_VERSION"
  exit 0
fi

if [[ "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  help_page
  exit 0
fi

if [[ "${1:-}" == "update" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm update [--force]"
    exit 2
  fi
  update_swm "${2:-}"
  exit $?
fi

check_for_update

if (( $# == 0 )); then
  manage_worktrees "."
  exit $?
fi

if [[ "${1:-}" == "manage" ]]; then
  if [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
    help_page
    exit 0
  fi
  if (( $# > 2 )); then
    print -u2 "Usage: swm manage [repository]"
    exit 2
  fi
  manage_worktrees "${2:-.}"
  exit $?
fi

if [[ "${1:-}" == "forget" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm forget [repository]"
    exit 2
  fi
  forget_project_defaults "${2:-.}"
  exit $?
fi

if [[ "${1:-}" == "remove" || "${1:-}" == "rm" ]]; then
  if (( $# > 3 )); then
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    exit 2
  fi
  remove_worktree "${2:-}" "${3:-}"
  exit $?
fi

with_env=false
typeset -a create_args
create_args=()

for arg in "$@"; do
  case "$arg" in
    --with-env)
      with_env=true
      ;;
    -*)
      print -u2 "Unknown option: $arg"
      usage
      exit 2
      ;;
    *)
      create_args+=("$arg")
      ;;
  esac
done

if (( ${#create_args} > 3 )); then
  usage
  exit 2
fi

worktree_name="${create_args[1]:-}"
branch_from="${create_args[2]:-}"
repo_input="${create_args[3]:-.}"

repo="$(git -C "$repo_input" rev-parse --show-toplevel)"

source_env="${repo}/.env"
if [[ "$with_env" == true ]]; then
  if [[ ! -f "$source_env" || ! -r "$source_env" ]]; then
    print -u2 "Cannot use --with-env because the source .env is missing or unreadable:"
    print -u2 "  $source_env"
    exit 1
  fi

  if git -C "$repo" ls-files --error-unmatch .env >/dev/null 2>&1; then
    print -u2 "Refusing --with-env because .env is tracked by Git."
    print -u2 "This option is intended for ignored, machine-local Laravel .env files."
    exit 1
  fi

  if ! git -C "$repo" check-ignore -q -- .env; then
    print -u2 "Refusing --with-env because .env is not ignored by Git."
    print -u2 "Add .env to the repository's .gitignore before using this option."
    exit 1
  fi
fi

default_branch_from="$(
  git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD \
    2>/dev/null | sed 's#^origin/##' || true
)"
default_branch_from="${default_branch_from:-HEAD}"

if [[ -z "$worktree_name" ]]; then
  read "worktree_name?Worktree / new branch name: "
fi

if [[ -z "$branch_from" ]]; then
  read "branch_from?Branch from [$default_branch_from]: "
  branch_from="${branch_from:-$default_branch_from}"
fi

if [[ -z "$worktree_name" || -z "$branch_from" ]]; then
  print -u2 "Both the worktree name and branch-from value are required."
  exit 2
fi

# The requested worktree name is also the new Git branch name.
new_branch="$worktree_name"
git -C "$repo" check-ref-format --branch "$new_branch" >/dev/null

if git -C "$repo" show-ref --verify --quiet "refs/heads/$new_branch"; then
  print -u2 "Local branch already exists: $new_branch"
  print -u2 "Choose a new worktree name/branch."
  exit 1
fi

if git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$new_branch"; then
  print -u2 "Remote branch already exists: origin/$new_branch"
  print -u2 "Choose a new worktree name/branch."
  exit 1
fi

# Herd derives the local hostname from the immediate directory name.
site_name="$(site_slug "$worktree_name")"

if [[ -z "$site_name" || ${#site_name} -gt 63 ]]; then
  print -u2 "The worktree name must produce a non-empty DNS label of at most 63 characters."
  exit 1
fi

worktree_root="$(default_worktree_root)"
worktree_path="${worktree_root}/${site_name}"

if [[ -e "$worktree_path" ]]; then
  print -u2 "Destination already exists: $worktree_path"
  exit 1
fi

# Refresh simple origin branch names so "dev" and "main" use the latest
# remote-tracking commit. If fetching is unavailable, fall back to the cached
# ref and say so.
if [[ "$branch_from" != */* ]] \
  && [[ ! "$branch_from" =~ ^[0-9a-fA-F]{7,64}$ ]] \
  && git -C "$repo" remote get-url origin >/dev/null 2>&1; then
  print "Refreshing origin/$branch_from…"
  if ! git -C "$repo" fetch --quiet origin "$branch_from"; then
    print -u2 "Warning: fetch failed; using the currently available ref."
  fi
fi

# Prefer a named remote branch when both origin/dev and a local dev exist.
# Explicit refs such as origin/dev, tags, and commit SHAs are used as written.
if [[ "$branch_from" != */* ]] \
  && git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch_from"; then
  start_point="origin/$branch_from"
elif git -C "$repo" rev-parse --verify --quiet "${branch_from}^{commit}" >/dev/null; then
  start_point="$branch_from"
elif git -C "$repo" rev-parse --verify --quiet "origin/${branch_from}^{commit}" >/dev/null; then
  start_point="origin/$branch_from"
else
  print -u2 "Cannot find branch-from ref: $branch_from"
  print -u2 "Try git fetch first, or pass an explicit ref such as origin/main."
  exit 1
fi

# Check Solo before changing the repository so a disabled API cannot leave a
# newly created worktree waiting to be imported.
solo status >/dev/null

mkdir -p -- "$worktree_root"
canonical_root="${worktree_root:A}"

# Herd is optional. Without it, the worktree is still created and imported into
# Solo; only the local site URL and parked-path handling are skipped.
site_url=""
if has_herd; then
  if ! command -v jq >/dev/null; then
    print -u2 "jq is required to verify Laravel Herd's parked paths."
    exit 1
  fi

  tld="$(herd tld)"
  site_url="http://${site_name}.${tld}"

  # Keep custom SWM_ROOT locations working by parking them once when necessary.
  if ! herd paths \
    | jq -e --arg root "$canonical_root" \
        'map(rtrimstr("/")) | index($root) != null' >/dev/null; then
    herd park "$canonical_root"
  fi
fi

print "Creating branch '$new_branch' from '$start_point'…"
git -C "$repo" worktree add -b "$new_branch" "$worktree_path" "$start_point"

if [[ "$with_env" == true ]]; then
  destination_env="${worktree_path}/.env"

  if ! git -C "$worktree_path" check-ignore -q -- .env; then
    print -u2 "Worktree created, but its target branch does not ignore .env."
    print -u2 "No environment file was copied and the project was not added to Solo."
    print -u2 "Clean up with: swm remove '$worktree_name'"
    exit 1
  fi

  if [[ -e "$destination_env" ]]; then
    print -u2 "Worktree created, but its .env already exists; it was not overwritten:"
    print -u2 "  $destination_env"
    exit 1
  fi

  /bin/cp -p "$source_env" "$destination_env"
  set_env_value "$destination_env" "APP_NAME" "\"${site_name}\""

  # Without Herd there is no generated local URL, so the copied APP_URL is left
  # as-is rather than pointed at a host that does not resolve.
  if [[ -n "$site_url" ]]; then
    set_env_value "$destination_env" "APP_URL" "$site_url"
  fi
fi

repo_name="$(repository_name "$repo")"
if ! solo projects create "${repo_name}: ${new_branch}" "$worktree_path"; then
  print -u2 "Worktree created, but Solo import failed."
  print -u2 "Retry with: solo projects create '${repo_name}: ${new_branch}' '$worktree_path'"
  exit 1
fi

print
print "Created and added to Solo:"
print "  Branch:  $new_branch"
print "  From:    $start_point"
print "  Path:    $worktree_path"
[[ -n "$site_url" ]] && print "  URL:     $site_url"
if [[ "$with_env" == true ]]; then
  if [[ -n "$site_url" ]]; then
    print "  Env:     copied; APP_NAME and APP_URL updated"
  else
    print "  Env:     copied; APP_NAME updated"
  fi
fi
