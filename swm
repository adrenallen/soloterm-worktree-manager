  print
  section "PATHS"
  print -r -- "  With Herd:    \$HOME/Herd/<site-name>"
  print -r -- "  Without Herd: \$HOME/worktrees/<site-name>"
  print -r -- "  Override the root with: SWM_ROOT=/another/path"
  print
  section "ENVIRONMENT"
  print -r -- "  SWM_ROOT                     Worktree root directory."
  print -r -- "  SWM_NO_UPDATE_CHECK=1        Disable the periodic update check."
  print -r -- "  SWM_UPDATE_CHECK_INTERVAL    Seconds between checks (default 172800)."
  print -r -- "  NO_COLOR                     Disable colour. Colour is also off"
  print -r -- "                               automatically when output is piped or"
  print -r -- "                               TERM is dumb."
  print -r -- "  SWM_HYPERLINKS               1 or 0 to force clickable links on"
  print -r -- "                               or off, instead of detecting."
  print
  section "EXAMPLES"
  print -r -- "  swm checkout-redesign dev --with-env"
  print -r -- "  swm api-fix main /path/to/project"
  print -r -- "  swm manage"
  print -r -- "  swm remove checkout-redesign"
  print -r -- "  swm update"
  print
  section "REQUIREMENTS"
  print -r -- "  Git, Solo, and Solo's local HTTP API. swm brings its own zsh"
  print -r -- "  interpreter, so the shell you use interactively does not matter."
  print -r -- "  jq, curl, gh, and Laravel Herd are optional; run swm health to"
  print -r -- "  see what is present and what each missing piece would add."
}

# The DNS-safe form of a name, at whatever length it comes out. Callers that
# need a usable folder or hostname want site_slug instead.
raw_slug() {
  print -r -- "$1" \
    | tr '[:upper:]_/' '[:lower:]--' \
    | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-//; s/-$//'
}

# A DNS label is capped at 63 characters, and Herd derives the hostname from
# the folder name, so a longer name is shortened rather than refused. The cap
# is applied here rather than at each call site so that creating and removing
# one worktree name always agree on which folder it is.
SITE_NAME_LIMIT=63

site_slug() {
  local slug=""
  slug="$(raw_slug "$1")"

  if (( ${#slug} > SITE_NAME_LIMIT )); then
    slug="${slug[1,$SITE_NAME_LIMIT]}"
    # raw_slug collapsed every run of dashes, so the cut can expose at most one
    # trailing dash, which a DNS label may not end with.
    slug="${slug%-}"
  fi

  print -r -- "$slug"
}

update_cache_file() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/swm/update-check"
}

# Read the version out of a swm script without executing any of it.
script_version() {
  sed -n -E 's/^SWM_VERSION="([^"]+)"$/\1/p' "$1" | head -1
}

download_swm() {
  curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 \
    --max-time 20 -o "$1" -- "$SWM_SOURCE_URL"
}

# Guard against a truncated download, an HTML error page, or anything else that
# is not a runnable swm. This is an integrity check, not an authenticity one.
valid_swm_script() {
  local candidate="$1"
  [[ -s "$candidate" ]] || return 1
  # Any zsh shebang: installs have shipped both /bin/zsh and env zsh.
  [[ "$(head -1 -- "$candidate")" == "#!"*zsh ]] || return 1
  [[ -n "$(script_version "$candidate")" ]] || return 1

  local interpreter=""
  interpreter="$(zsh_interpreter)" || return 1
  "$interpreter" -n "$candidate" 2>/dev/null || return 1
}

update_swm() {
  local force="${1:-}"

  if [[ -n "$force" && "$force" != "--force" ]]; then
    fail "Unknown option: $force"
    print -u2 "Usage: swm update [--force]"
    return 2
  fi

  if ! command -v curl >/dev/null; then
    fail "curl is required to update swm."
    return 1
  fi

  local target="$SWM_SCRIPT"
  if [[ ! -f "$target" ]]; then
    print -u2 "Cannot locate the running swm script to update."
    return 1
  fi

  local target_directory="${target:h}"

  case "$target" in
    /opt/homebrew/*|/usr/local/Cellar/*|/nix/store/*|/opt/local/*)
      print -u2 "swm appears to be installed by a package manager:"
      detail "$target"
      print -u2 "Update it with that package manager instead."
      return 1
      ;;
  esac

  # A checkout is someone's working copy of swm itself; overwriting it would
  # silently discard their edits.
  if [[ "$force" != "--force" ]] \
    && git -C "$target_directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -u2 "swm is running from a Git checkout:"
    detail "$target"
    print -u2 "Use git to update it, or re-run with --force to overwrite."
    return 1
  fi

  if [[ ! -w "$target" || ! -w "$target_directory" ]]; then
    print -u2 "No write permission for the installed script:"
    detail "$target"
    return 1
  fi

  hint "Checking $SWM_REPOSITORY for updates…"

  # Stage the download beside the target so the replacement below is a
  # same-filesystem rename rather than a cross-device copy.
  local staged="$(mktemp "${target_directory}/.swm-update.XXXXXX")"

  if ! download_swm "$staged"; then
    rm -f -- "$staged"
    print -u2 "Could not download the latest swm from $SWM_SOURCE_URL"
    return 1
  fi

  if ! valid_swm_script "$staged"; then
    rm -f -- "$staged"
    print -u2 "The downloaded file is not a valid swm script; nothing was changed."
    return 1
  fi

  local latest="$(script_version "$staged")"

  autoload -Uz is-at-least
  if [[ "$force" != "--force" ]] && is-at-least "$latest" "$SWM_VERSION"; then
    rm -f -- "$staged"
    ok "Already up to date (swm $SWM_VERSION)"
    return 0
  fi

  if ! chmod "$(file_mode "$target")" "$staged"; then
    rm -f -- "$staged"
    fail "Could not set permissions on the downloaded script."
    return 1
  fi

  # Renaming swaps the directory entry and leaves this running script's inode
  # intact, so the in-flight process keeps reading the old file safely.
  if ! mv -f -- "$staged" "$target"; then
    rm -f -- "$staged"
    fail "Could not replace $target"
    return 1
  fi

  # Keep the notice from advertising a version that is now installed.
  rm -f -- "$(update_cache_file)"

  print
  ok "Updated swm ${SWM_VERSION} → ${latest}"
  field "Path" "$(tilde "$target")"
  print
}

# Refresh the cached latest-version marker without blocking this run. The
# timestamp is recorded even when the download fails so an offline machine
# backs off for the full interval instead of retrying on every invocation.
refresh_update_cache() {
  local cache_file="$1" now="$2" previous_version="$3"
  local cache_directory="${cache_file:h}"

  {
    mkdir -p -- "$cache_directory" || exit 0

    local staged="" latest="$previous_version" staged_cache=""
    staged="$(mktemp "${TMPDIR:-/tmp}/swm-check.XXXXXX")" || exit 0

    if download_swm "$staged" && valid_swm_script "$staged"; then
      latest="$(script_version "$staged")"
      [[ -n "$latest" ]] || latest="$previous_version"
    fi
    rm -f -- "$staged"

    staged_cache="$(mktemp "${cache_directory}/staged.XXXXXX")" || exit 0
    print -r -- "$now" > "$staged_cache"
    print -r -- "$latest" >> "$staged_cache"
    mv -f -- "$staged_cache" "$cache_file"
  } >/dev/null 2>&1 &!
}

# Report from the cached result so no run ever waits on the network, then kick
# off a background refresh when the interval has elapsed.
check_for_update() {
  [[ -z "${SWM_NO_UPDATE_CHECK:-}" ]] || return 0
  command -v curl >/dev/null || return 0

  local cache_file="$(update_cache_file)"
  local interval="${SWM_UPDATE_CHECK_INTERVAL:-172800}"
  local now="$(date +%s)"
  local checked_at=0
  local cached_version=""

  if [[ -f "$cache_file" ]]; then
    local -a cache_lines
    cache_lines=("${(@f)$(<"$cache_file")}")
    checked_at="${cache_lines[1]:-0}"
    cached_version="${cache_lines[2]:-}"
    [[ "$checked_at" == <-> ]] || checked_at=0
  fi

  if [[ -n "$cached_version" ]]; then
    autoload -Uz is-at-least
    if ! is-at-least "$cached_version" "$SWM_VERSION"; then
      print -u2 -r -- "${EDIM}swm ${cached_version} is available (installed: ${SWM_VERSION}) ${EM} run: swm update${ER}"
      print -u2
    fi
  fi

  if (( now - checked_at >= interval )); then
    refresh_update_cache "$cache_file" "$now" "$cached_version"
  fi
}

project_defaults_file() {
  print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/swm/projects.conf"
}

# Identify a project by its main worktree, so every linked worktree of the same
# clone resolves to one key.
main_worktree_path() {
  local first="$(
    git -C "$1" worktree list --porcelain | sed -n '1s/^worktree //p'
  )"
  [[ -n "$first" ]] || return 1
  print -r -- "${first:A}"
}

# Entries are "<setting>=<value><TAB><project path>". Splitting on the first tab
# keeps the path intact even in the unlikely case that it contains one.
project_default() {
  local project_path="$1" setting="$2"
  local file="$(project_defaults_file)"
  [[ -f "$file" ]] || return 1

  local line entry stored_path
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != '#'* && "$line" == *$'\t'* ]] || continue
    entry="${line%%$'\t'*}"
    stored_path="${line#*$'\t'}"
    [[ "$stored_path" == "$project_path" && "${entry%%=*}" == "$setting" ]] \
      || continue
    print -r -- "${entry#*=}"
    return 0
  done < "$file"

  return 1
}

set_project_default() {
  local project_path="$1" setting="$2" value="$3"
  local file="$(project_defaults_file)"
  local directory="${file:h}"

  mkdir -p -- "$directory" || return 1
  local staged=""
  staged="$(mktemp "${directory}/.projects.XXXXXX")" || return 1

  {
    print -r -- "# swm project defaults"
    if [[ -f "$file" ]]; then
      local line entry stored_path
      while IFS= read -r line; do
        [[ -n "$line" && "$line" != '#'* ]] || continue
        if [[ "$line" == *$'\t'* ]]; then
          entry="${line%%$'\t'*}"
          stored_path="${line#*$'\t'}"
          # Drop any previous value for this project and setting.
          if [[ "$stored_path" == "$project_path" \
            && "${entry%%=*}" == "$setting" ]]; then
            continue
          fi
        fi
        print -r -- "$line"
      done < "$file"
    fi
    # An empty value removes the entry, so this block must still exit zero.
    if [[ -n "$value" ]]; then
      print -r -- "${setting}=${value}"$'\t'"${project_path}"
    fi
  } >> "$staged" || { rm -f -- "$staged"; return 1; }

  mv -f -- "$staged" "$file" || { rm -f -- "$staged"; return 1; }
}

forget_project_defaults() {
  local repo_input="${1:-.}"
  local repo=""

  if ! repo="$(git -C "$repo_input" rev-parse --show-toplevel 2>/dev/null)"; then
    print -u2 "swm forget must run inside a Git repository, or receive one:"
    print -u2 "  swm forget /path/to/repository"
    return 1
  fi

  local project_path=""
  if ! project_path="$(main_worktree_path "$repo")"; then
    fail "Could not determine the main worktree for: $repo"
    return 1
  fi

  local current=""
  if ! current="$(project_default "$project_path" "fork-env")"; then
    info "No remembered defaults for ${project_path:t}"
    field "Path" "$(tilde "$project_path")"
    return 0
  fi

  if ! set_project_default "$project_path" "fork-env" ""; then
    fail "Could not update $(project_defaults_file)"
    return 1
  fi

  ok "Forgot the .env default for ${project_path:t}"
  field "Was" "$current"
  field "Path" "$(tilde "$project_path")"
}

has_herd() {
  command -v herd >/dev/null
}

has_gh() {
  command -v gh >/dev/null
}

# Emit "<branch><TAB><state><TAB><number><TAB><url>" for the repository's pull
# requests. One request covers every branch, because asking per worktree would
# be a round trip each. gh carries its own jq, so this adds no external
# dependency. Every failure -- gh missing, signed out, no GitHub remote,
# offline -- is reported as "no data" so the listing goes without the column.
pull_request_rows() {
  has_gh || return 1

  local rows=""
  rows="$(
    cd "$1" 2>/dev/null || exit 1
    gh pr list --state all --limit 200 \
      --json number,state,isDraft,headRefName,url \
      --jq '.[] | [.headRefName,
                   (if .isDraft and .state == "OPEN" then "DRAFT" else .state end),
                   .number,
                   .url] | @tsv' 2>/dev/null
  )" || return 1

  [[ -n "$rows" ]] || return 1
  print -r -- "$rows"
}

# A branch can carry several pull requests over its life. An open one describes
# it best, then a merged one, and a closed one last, so the column answers "is
# this branch finished" rather than "what happened most recently".
pull_request_for() {
  local rows="$1" branch="$2"
  local line="" rest="" name="" state="" number="" url=""
  local -i rank=0
  local -i best_rank=99
  local best=""

  for line in "${(@f)rows}"; do
    name="${line%%$'\t'*}"
    [[ "$name" == "$branch" ]] || continue

    # Split field by field: a URL can contain anything, so taking the last
    # field from the end would be the only safe shortcut and there are four.
    rest="${line#*$'\t'}"
    state="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    number="${rest%%$'\t'*}"
    url="${rest#*$'\t'}"

    case "$state" in
      OPEN)   rank=0 ;;
      DRAFT)  rank=1 ;;
      MERGED) rank=2 ;;
      CLOSED) rank=3 ;;
      *)      rank=4 ;;
    esac

    if (( rank < best_rank )); then
      best_rank=$rank
      best="${state}"$'\t'"${number}"$'\t'"${url}"
    fi
  done

  [[ -n "$best" ]] || return 1
  print -r -- "$best"
}

# Lowercase label and colour for a pull request state.
pull_request_style() {
  case "$1" in
    OPEN)   print -r -- "open"$'\t'"$GRN" ;;
    DRAFT)  print -r -- "draft"$'\t'"$D" ;;
    MERGED) print -r -- "merged"$'\t'"$MAG" ;;
    CLOSED) print -r -- "closed"$'\t'"$RED" ;;
    *)      print -r -- "${1:l}"$'\t'"$D" ;;
  esac
}

# Solo pages its project list and clamps the page size, so one request can
# quietly omit projects on a large install. Every page is walked instead.
SOLO_PAGE_LIMIT=500

# Emit "<id><TAB><path>" for every Solo project, trailing slash trimmed. jq is
# used when it is installed because it parses Solo's JSON exactly; without it
# the CLI's tab-separated table gives the same two columns.
solo_projects() {
  if has_jq; then
    solo_projects_via_json
  else
    solo_projects_via_table
  fi
}

solo_projects_via_json() {
  local offset=0 page="" next=""

  while true; do
    page="$(
      solo projects list --json --limit "$SOLO_PAGE_LIMIT" --offset "$offset"
    )" || return 1

    print -r -- "$page" \
      | jq -r '.data.projects[]? | "\(.id)\t\(.path | rtrimstr("/"))"' \
      || return 1

    next="$(print -r -- "$page" | jq -r '.data.nextOffset // empty')" || return 1
    # Requiring forward progress keeps an unexpected response from looping.
    [[ "$next" == <-> ]] && (( next > offset )) || break
    offset="$next"
  done
}

# The table is "ID<TAB>NAME<TAB>DISPLAY NAME<TAB>PATH" under a header row and
# above a "Showing <n> of <total> projects." footer. Only the first and last
# columns are read, so a name containing a tab cannot shift the path.
solo_projects_via_table() {
  # Not named "path": zsh ties that to $PATH, and a local one empties it.
  local offset=0 page="" line="" id="" project_path=""
  local -i emitted=0 page_rows=0 total=0
  local -a words

  while true; do
    page="$(
      solo projects list --limit "$SOLO_PAGE_LIMIT" --offset "$offset"
    )" || return 1

    page_rows=0
    for line in "${(@f)page}"; do
      if [[ "$line" == "Showing "* ]]; then
        words=(${=line})
        [[ "${words[4]:-}" == <-> ]] && total="${words[4]}"
        continue
      fi
      [[ "$line" == *$'\t'* ]] || continue

      id="${line%%$'\t'*}"
      # Skips the header row, whose first column is the literal "ID".
      [[ "$id" == <-> ]] || continue

      project_path="${line##*$'\t'}"
      print -r -- "${id}"$'\t'"${project_path%/}"
      (( ++page_rows, ++emitted ))
    done

    (( page_rows > 0 && emitted < total )) || break
    offset=$emitted
  done
}

# Print the Solo project id registered at a path. Returns 1 when there is no
# project and 2 when more than one unexpectedly matches, so callers can tell
# "nothing to do" apart from "refuse to guess".
solo_project_id_for() {
  local projects="$1" worktree_path="${2%/}" line=""
  local -a ids
  ids=()

  for line in "${(@f)projects}"; do
    if [[ "$line" == *$'\t'* && "${line#*$'\t'}" == "$worktree_path" ]]; then
      ids+=("${line%%$'\t'*}")
    fi
  done

  if (( ${#ids} > 1 )); then
    fail "Multiple Solo projects unexpectedly match: $worktree_path"
    return 2
  fi

  (( ${#ids} == 1 )) || return 1
  print -r -- "${ids[1]}"
}

solo_has_project() {
  local projects="$1" worktree_path="${2%/}" line=""

  for line in "${(@f)projects}"; do
    if [[ "$line" == *$'\t'* && "${line#*$'\t'}" == "$worktree_path" ]]; then
      return 0
    fi
  done

  return 1
}

# Herd only serves a directory whose parent is parked, so a generated URL is
# only real once this is true. herd paths prints a JSON array of strings, one
# per line, which is why the jq-less branch can read it a line at a time.
herd_path_is_parked() {
  local root="${1%/}" paths="" line="" parked=""

  paths="$(herd paths)" || return 1

  if has_jq; then
    print -r -- "$paths" \
      | jq -e --arg root "$root" \
          'map(rtrimstr("/")) | index($root) != null' >/dev/null
    return $?
  fi

  for line in "${(@f)paths}"; do
    [[ "$line" == *\"*\"* ]] || continue
    parked="${line#*\"}"
    parked="${parked%\"*}"
    [[ "${parked%/}" == "$root" ]] && return 0
  done

  return 1
}

# Herd users keep the parked $HOME/Herd default. Without Herd, fall back to a
# neutral directory, but keep using an existing $HOME/Herd so worktrees created
# while Herd was installed stay visible after it is removed.
default_worktree_root() {
  if [[ -n "${SWM_ROOT:-}" ]]; then
    print -r -- "$SWM_ROOT"
  elif has_herd || [[ -d "$HOME/Herd" ]]; then
    print -r -- "$HOME/Herd"
  else
    print -r -- "$HOME/worktrees"
  fi
}

repository_name() {
  local repo_path="$1"
  local common_git_dir="$(
    cd "$repo_path"
    cd "$(git rev-parse --git-common-dir)"
    pwd -P
  )"

  if [[ "${common_git_dir:t}" == ".git" ]]; then
    print -r -- "${common_git_dir:h:t}"
  else
    print -r -- "${repo_path:t}"
  fi
}

set_env_value() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  local original_mode="$(file_mode "$env_file")"
  local temp_root="${TMPDIR:-/tmp}"
  local temp_file="$(mktemp "${temp_root%/}/swm-env.XXXXXX")"

  if ! awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    $0 ~ ("^" key "=") {
      if (!found) {
        print key "=" value
        found = 1
      }
      next
    }
    { print }
    END {
      if (!found) {
        print key "=" value
      }
    }
  ' "$env_file" > "$temp_file"; then
    rm -f -- "$temp_file"
    return 1
  fi

  if ! chmod "$original_mode" "$temp_file"; then
    rm -f -- "$temp_file"
    return 1
  fi

  if ! mv -f -- "$temp_file" "$env_file"; then
    rm -f -- "$temp_file"
    return 1
  fi
}

# Stop a project's commands and let them finish exiting. Solo returns from a
# stop before its processes are gone, and a build such as "composer i && npm i"
# keeps writing for a while after, which is what makes Git delete a directory
# that is being refilled underneath it.
quiesce_solo_project() {
  solo commands stop-all --project-id "$1" >/dev/null 2>&1 || true
  swm_sleep 2
}

remove_worktree() {
  local requested_name="${1:-}"
  local confirmation_flag="${2:-}"
  local worktree_root="$(default_worktree_root)"

  if [[ -z "$requested_name" ]]; then
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    return 2
  fi

  if [[ -n "$confirmation_flag" && "$confirmation_flag" != "--yes" ]]; then
    fail "Unknown option: $confirmation_flag"
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    return 2
  fi

  # site_slug shortens the same way creation did, so a name that was truncated
  # on the way in still resolves to its folder on the way out.
  local site_name="$(site_slug "$requested_name")"
  if [[ -z "$site_name" ]]; then
    fail "Invalid worktree name: $requested_name"
    return 1
  fi

  local canonical_root="${worktree_root:A}"
  local worktree_path="${canonical_root}/${site_name}"

  solo status >/dev/null

  local projects=""
  if ! projects="$(solo_projects)"; then
    fail "Could not list Solo projects."
    return 1
  fi

  local project_id=""
  local lookup_status=0

  # Assigned separately because the local builtin would mask the exit status.
  project_id="$(solo_project_id_for "$projects" "$worktree_path")" \
    || lookup_status=$?
  if (( lookup_status == 2 )); then
    return 1
  fi

  local branch_name=""
  local common_git_dir=""
  local delete_dirty=false
  local orphaned=false
  local vacated_cwd=""
  local return_to="$canonical_root"

  if [[ -e "$worktree_path" ]]; then
    if [[ ! -d "$worktree_path" || ! -f "$worktree_path/.git" ]]; then
      print -u2 "Refusing to remove a path that is not a linked Git worktree:"
      detail "$worktree_path"
      return 1
    fi

    local actual_top=""
    actual_top="$(
      git -C "$worktree_path" rev-parse --show-toplevel 2>/dev/null
    )" || actual_top=""

    if [[ -z "$actual_top" ]]; then
      # Git deletes a worktree's admin directory even when it fails to delete
      # the files, so a .git pointing at nothing is what a half-finished
      # removal leaves behind. worktree_path is built from SWM_ROOT, so
      # finishing that job cannot reach outside the managed root.
      orphaned=true
    elif [[ "${actual_top:A}" != "$worktree_path" ]]; then
      print -u2 "Refusing to remove an unexpected Git directory:"
      detail "$worktree_path"
      return 1
    fi
  fi

  # Git can no longer report on an orphan, and there is nothing left to
  # preserve: its branch and admin state were dealt with by the run that
  # stopped part-way.
  if [[ -e "$worktree_path" && "$orphaned" != true ]]; then
    local dirty_state="$(
      git -C "$worktree_path" status --porcelain --untracked-files=all
    )"
    if [[ -n "$dirty_state" ]]; then
      local -a dirty_files
      dirty_files=("${(@f)dirty_state}")
      print
      print -u2 -r -- "${ERED}${B}!${ER} ${B}Worktree has ${#dirty_files} uncommitted or untracked file(s)${ER}"
      print -u2 -r -- "  ${EDIM}--yes does not override this safety check${ER}"
      print

      while true; do
        local dirty_action=""
        if ! read "dirty_action?  ${B}Action${R} ${D}[s=show, d=delete anyway, c=cancel]${R} "; then
          hint "  Cancelled."
          return 0
        fi

        case "${dirty_action:l}" in
          s|show|files|"show files"|"show me the files")
            print
            git -C "$worktree_path" status --short --branch --untracked-files=all
            print
            ;;
          d|delete|force|"delete anyway")
            print
            print -u2 -r -- "${ERED}${B}!${ER} ${ERED}This permanently deletes these local changes.${ER}"
            local typed_name=""
            if ! read "typed_name?  ${B}Type '$site_name' to confirm${R} "; then
              hint "  Cancelled."
              return 0
            fi

            if [[ "$typed_name" != "$site_name" ]]; then
              hint "  Confirmation did not match. Cancelled."
              return 0
            fi

            delete_dirty=true
            break
            ;;
          c|cancel|q|quit|"")
            hint "  Cancelled."
            return 0
            ;;
          *)
            print -u2 "Choose show, delete anyway, or cancel."
            ;;
        esac
      done
    fi

    branch_name="$(
      git -C "$worktree_path" symbolic-ref --quiet --short HEAD \
        2>/dev/null || print -r -- "(detached HEAD)"
    )"

    common_git_dir="$(
      cd "$worktree_path"
      cd "$(git rev-parse --git-common-dir)"
      pwd -P
    )"
  fi

  # An orphan is still worth removing on its own, so this cannot be folded into
  # the branch above: it must consider the path missing entirely.
  if [[ ! -e "$worktree_path" && -z "$project_id" ]]; then
    fail "No managed worktree or Solo project found for: $requested_name"
    return 1
  fi

  print
  info "Cleanup target"
  field "Path" "$(tilde "$worktree_path")"
  [[ -n "$branch_name" ]] && field "Branch" "$branch_name ${D}(kept)${R}"
  if [[ "$orphaned" == true ]]; then
    field "State" "${YLW}files left by an interrupted removal${R}"
    field "Git" "${D}worktree already unregistered; branch already kept${R}"
  fi
  if [[ -n "$project_id" ]]; then
    field "Solo" "project $project_id"
  else
    field "Solo" "${D}already removed${R}"
  fi
  # Removing a Solo project stops every process in it, so running this from one
  # of that project's own terminals ends the session it is running in.
  if [[ -n "$project_id" && "${SOLO_PROJECT_ID:-}" == "$project_id" ]]; then
    field "Note" "${YLW}closes this Solo session${R} ${D}(removal finishes first)${R}"
  fi
  print

  if [[ "$confirmation_flag" != "--yes" && "$delete_dirty" != true ]]; then
    local answer=""
    if [[ "$orphaned" == true ]]; then
      read "answer?  ${B}Delete these leftover files?${R} ${D}[y/N]${R} "
    else
      read "answer?  ${B}Remove this worktree and its Solo project?${R} ${D}[y/N]${R} "
    fi
    if [[ "${answer:l}" != "y" && "${answer:l}" != "yes" ]]; then
      hint "  Cancelled."
      return 0
    fi
  fi

  # Stop Solo-managed processes before removing the directory they use. A build
  # command such as "composer i && npm i" writes thousands of files, and Solo
  # returns from a stop before its processes have actually exited, so stopping
  # the commands first and pausing is what keeps Git from deleting a directory
  # that is being refilled underneath it.
  # stop-all only stops command processes, so the terminal or agent running swm
  # survives this and the build that would race the deletion does not.
  if [[ -n "$project_id" ]]; then
    with_spinner "Stopping Solo processes…" quiesce_solo_project "$project_id"
  fi

  # Standing in the directory about to be deleted leaves every later command
  # with a cwd that no longer exists. swm can move its own; the calling shell
  # keeps a deleted cwd until the user changes it, which is reported at the end.
  if [[ "$PWD/" == "$worktree_path/"* ]]; then
    vacated_cwd="$worktree_path"
    if [[ "${common_git_dir:t}" == ".git" && -d "${common_git_dir:h}" ]]; then
      return_to="${common_git_dir:h}"
    fi
    cd -- "$return_to" 2>/dev/null || cd /
  fi

  if [[ -e "$worktree_path" && "$orphaned" == true ]]; then
    # Git has no record of this path any more, so only a plain delete is left.
    if ! with_spinner "Deleting leftover files…" rm -rf -- "$worktree_path"; then
      print -u2 -r -- "$SPIN_OUTPUT"
      fail "Could not delete the leftover files:"
      detail "$(tilde "$worktree_path")"
      return 1
    fi
  elif [[ -e "$worktree_path" ]]; then
    # Path checks plus the confirmations above make --force safe here, while
    # still allowing expected ignored files such as .env to be removed.
    local attempt=0
    local removed=false
    local remove_output=""

    while (( ++attempt <= 3 )); do
      if git -C "$worktree_path" rev-parse --show-toplevel >/dev/null 2>&1; then
        if with_spinner "Removing the worktree…" \
          git --git-dir="$common_git_dir" worktree remove --force "$worktree_path"; then
          removed=true
          break
        fi
        remove_output="$SPIN_OUTPUT"
      else
        # Git drops its admin directory even when it fails to delete the files,
        # so from here it can only report "not a working tree" and a plain
        # delete is all that is left. Removing this worktree is already
        # confirmed, so finish it rather than strand a directory Git can no
        # longer describe.
        if with_spinner "Deleting remaining files…" rm -rf -- "$worktree_path"; then
          removed=true
          break
        fi
        remove_output="$SPIN_OUTPUT"
      fi

      (( attempt < 3 )) || break
      hint "  Something is still writing to the worktree; retrying…"
      swm_sleep 2
    done

    if [[ "$removed" != true ]]; then
      print -u2 -r -- "$remove_output"

      # The two failures leave very different states and only one of them can
      # be retried as-is. Saying "run it again" for both is how a worktree ends
      # up stuck with no command that will finish it.
      if git -C "$worktree_path" rev-parse --show-toplevel >/dev/null 2>&1; then
        fail "Solo was removed, but Git could not remove the worktree."
        detail "Stop whatever is writing to it, then run this command again."
      else
        fail "Solo and the Git worktree are gone, but these files could not be deleted:"
        detail "$(tilde "$worktree_path")"
        detail "Remove them yourself, or fix what is holding them and run this again."
      fi
      return 1
    fi
  fi

  # Unregistering the project stops every process in it, including the terminal
  # or agent swm may itself be running in, so it goes last: by the time this can
  # cut the session off, the removal it was asked to do is already finished.
  if [[ -n "$project_id" ]]; then
    if ! with_spinner "Removing the Solo project…" \
      solo projects delete "$project_id" --confirm-stop-running; then
      print -u2 -r -- "$SPIN_OUTPUT"
      fail "The worktree was removed, but its Solo project was not."
      detail "Remove it in Solo, or run: solo projects delete $project_id"
      return 1
    fi
  fi

  print
  ok "Cleanup complete"
  print
  field "Removed" "$(tilde "$worktree_path")"
  [[ -n "$branch_name" ]] && field "Kept" "branch $branch_name"
  if [[ -n "$vacated_cwd" ]]; then
    field "Note" "${YLW}your shell is still in the removed directory${R}"
    field "Run" "cd $(tilde "$return_to")"
  fi
  print
}

# Register an existing directory with Solo. Nothing on disk is created or
# changed: no branch, no worktree, no .env, nothing moved. Shared by the
# "swm add" command and manage mode's [a]dd action.
add_to_solo() {
  local target_input="${1:-.}"

  if [[ ! -d "$target_input" ]]; then
    fail "Not a directory: $target_input"
    return 1
  fi

  local target="${target_input:A}"
  local branch=""

  # Git's own storage is never a project. It is reachable by tab completion,
  # and --show-toplevel below cannot resolve out of it.
  if [[ "${target:t}" == ".git" || "$target" == *"/.git/"* ]]; then
    fail "Refusing to add Git's internal directory: $(tilde "$target")"
    detail "Run swm add from the worktree itself."
    return 1
  fi

  # Registering a subdirectory of a checkout would give Solo a project that is
  # not the worktree, so resolve to the worktree root first. --show-toplevel is
  # the probe because --is-inside-work-tree prints "false" and still exits 0.
  local top=""
  if top="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" \
    && [[ -n "$top" ]]; then
    target="${top:A}"

    if ! branch="$(git -C "$target" symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
      local head_sha=""
      head_sha="$(git -C "$target" rev-parse --short=8 HEAD 2>/dev/null)" \
        || head_sha="unknown"
      branch="detached@${head_sha}"
    fi
  fi

  solo status >/dev/null

  local projects=""
  if ! projects="$(solo_projects)"; then
    fail "Could not list Solo projects."
    return 1
  fi

  local existing_id=""
  local lookup_status=0
  existing_id="$(solo_project_id_for "$projects" "$target")" || lookup_status=$?
  if (( lookup_status == 2 )); then
    return 1
  fi

  if (( lookup_status == 0 )); then
    print
    info "Already a Solo project"
    field "Project" "$existing_id"
    field "Path" "$(tilde "$target")"
    print
    return 0
  fi

  # Named the way worktree creation names things, so one repository's projects
  # group together in Solo. A directory outside a repository keeps its own name.
  local project_label=""
  if [[ -n "$branch" ]]; then
    project_label="$(repository_name "$target"): ${branch}"
  else
    project_label="${target:t}"
  fi

  local solo_output=""
  if ! solo_output="$(
    solo projects create "$project_label" "$target" 2>&1
  )"; then
    print -u2 -r -- "$solo_output"
    fail "Solo import failed."
    detail "Retry with: solo projects create '$project_label' '$target'"
    return 1
  fi

  print
  ok "Added to Solo"
  print
  field "Name" "${B}${project_label}${R}"
  [[ -n "$branch" ]] && field "Branch" "$branch"
  field "Path" "$(tilde "$target")"

  # Adding does not park anything, so only advertise a URL Herd really serves.
  local canonical_root=""
  canonical_root="${$(default_worktree_root):A}"
  if has_herd && [[ "$target" == "$canonical_root"/* ]] \
    && herd_path_is_parked "$canonical_root"; then
    field "URL" "${CYN}http://${target:t}.$(herd tld)${R}"
  fi
  print
}

typeset -gi HEALTH_PROBLEMS=0
typeset -gi HEALTH_NOTES=0

# Rows are printed as they are checked so a hang is attributable to the last
# line on screen. Only REQUIRED failures count towards the exit status.
health_ok() {
  printf "   %s%s%s  %-11s %s\n" "$GRN" "$MARK_OK" "$R" "$1" "$2"
}

health_warn() {
  printf "   %s%s%s  %-11s %s\n" "$YLW" "$MARK_WARN" "$R" "$1" "$2"
  (( ++HEALTH_NOTES ))
}

health_bad() {
  printf "   %s%s%s  %-11s %s\n" "$RED" "$MARK_BAD" "$R" "$1" "$2"
  (( ++HEALTH_PROBLEMS ))
}

health_hint() {
  print -r -- "      ${D}${MARK_TO} $1${R}"
}

health_check() {
  local mode="${1:-}"

  if [[ -n "$mode" && "$mode" != "--fix" ]]; then
    fail "Unknown option: $mode"
    print -u2 "Usage: swm health [--fix]"
    return 2
  fi

  local fix=false
  [[ "$mode" == "--fix" ]] && fix=true

  HEALTH_PROBLEMS=0
  HEALTH_NOTES=0
  # --fix is limited to repairs that cannot lose anything: creating the
  # worktree root, and installing optional tools through an existing Homebrew.
  local fix_root=""
  local fix_jq=false

  if ! banner; then
    print -r -- "swm ${SWM_VERSION}"
  fi
  print

  section "  REQUIRED"

  autoload -Uz is-at-least
  local zsh_path=""
  if ! is-at-least 5.0 "$ZSH_VERSION"; then
    health_bad "zsh" "$ZSH_VERSION ${D}(swm needs 5.0 or newer)${R}"
  elif zsh_path="$(zsh_interpreter)"; then
    health_ok "zsh" "$ZSH_VERSION ${D}$(tilde "$zsh_path")${R}"
  else
    # swm is running under zsh either way; update needs a findable one to
    # syntax-check what it downloads before installing it.
    health_warn "zsh" "$ZSH_VERSION ${D}(none on PATH; swm update is disabled)${R}"
  fi

  if command -v git >/dev/null; then
    local git_version=""
    git_version="$(git --version 2>/dev/null)" || git_version="unknown version"
    health_ok "git" "${git_version#git version }"
  else
    health_bad "git" "not found"
    health_hint "install the command line tools: xcode-select --install"
  fi

  local solo_status_output=""
  if ! command -v solo >/dev/null; then
    health_bad "solo" "CLI not found on PATH"
    health_hint "install Solo from https://soloterm.com and enable its CLI"
  elif ! solo_status_output="$(solo status 2>&1)"; then
    health_bad "solo" "CLI found, but its local API is not answering"
    health_hint "open Solo and enable the local HTTP API in its settings"
  else
    local line="" project_count=""
    for line in "${(@f)solo_status_output}"; do
      if [[ "$line" == "Projects: "* ]]; then
        project_count="${line#Projects: }"
      fi
    done
    health_ok "solo" "API ready${project_count:+ ${D}(${project_count} project(s))${R}}"
  fi

  print
  section "  OPTIONAL"

  if has_jq; then
    local jq_version=""
    jq_version="$(jq --version 2>/dev/null)" || jq_version="unknown version"
    health_ok "jq" "${jq_version#jq-} ${D}(parsing Solo's JSON)${R}"
  else
    health_warn "jq" "not found ${D}(reading Solo's table output instead)${R}"
    health_hint "for exact JSON parsing: brew install jq"
    fix_jq=true
  fi

  if command -v curl >/dev/null; then
    health_ok "curl" "available ${D}(swm update)${R}"
  else
    health_warn "curl" "not found ${D}(swm update and update checks are off)${R}"
  fi

  if ! has_gh; then
    health_warn "gh" "not found ${D}(no pull request column in manage)${R}"
    health_hint "for PR status per branch: brew install gh && gh auth login"
  elif ! gh auth status >/dev/null 2>&1; then
    health_warn "gh" "installed, but not signed in"
    health_hint "sign in to show pull request status: gh auth login"
  else
    health_ok "gh" "signed in ${D}(pull request status in manage)${R}"
  fi

  local worktree_root=""
  worktree_root="$(default_worktree_root)"
  local canonical_root="${worktree_root:A}"

  if has_herd; then
    local tld=""
    tld="$(herd tld 2>/dev/null)" || tld=""
    if [[ -z "$tld" ]]; then
      health_warn "herd" "installed, but 'herd tld' failed"
    elif herd_path_is_parked "$canonical_root"; then
      health_ok "herd" "serving *.${tld} ${D}from $(tilde "$canonical_root")${R}"
    else
      health_warn "herd" "$(tilde "$canonical_root") is not parked"
      health_hint "swm parks it when it next creates a worktree there"
    fi
  else
    health_warn "herd" "not found ${D}(no .test URL, APP_URL left alone)${R}"
  fi

  print
  section "  ENVIRONMENT"

  if [[ ! -d "$canonical_root" ]]; then
    health_warn "worktrees" "$(tilde "$canonical_root") ${D}(does not exist yet)${R}"
    health_hint "create it: mkdir -p $(tilde "$canonical_root")"
    fix_root="$canonical_root"
  elif [[ ! -w "$canonical_root" ]]; then
    health_bad "worktrees" "$(tilde "$canonical_root") is not writable"
  else
    health_ok "worktrees" "$(tilde "$canonical_root")"
  fi

  local path_swm="${commands[swm]:-}"
  local updatable="${D}(updatable)${R}"
  if [[ ! -w "$SWM_SCRIPT" || ! -w "${SWM_SCRIPT:h}" ]]; then
    updatable="${D}(read-only; swm update cannot replace it)${R}"
  fi

  if [[ -z "$path_swm" ]]; then
    health_warn "install" "$(tilde "$SWM_SCRIPT") ${D}(not on PATH)${R}"
    health_hint "add to your shell profile: export PATH=\"${SWM_SCRIPT:h}:\$PATH\""
  elif [[ "${path_swm:A}" != "$SWM_SCRIPT" ]]; then
    health_warn "install" "running $(tilde "$SWM_SCRIPT")"
    health_hint "PATH resolves swm to $(tilde "${path_swm:A}") instead"
  else
    health_ok "install" "$(tilde "$SWM_SCRIPT") ${updatable}"
  fi

  local defaults_file=""
  defaults_file="$(project_defaults_file)"
  local remembered=0
  if [[ -f "$defaults_file" ]]; then
    remembered="$(grep -c $'\t' "$defaults_file" 2>/dev/null)" || remembered=0
  fi
  health_ok "config" "$(tilde "$defaults_file") ${D}(${remembered} remembered)${R}"

  local terminal_note=""
  if swm_color_fd 1; then
    terminal_note="colour"
  else
    terminal_note="no colour"
  fi
  if swm_unicode; then
    terminal_note="${terminal_note}, unicode"
  else
    terminal_note="${terminal_note}, ascii only"
  fi
  health_ok "terminal" "${TERM:-unset} ${D}(${terminal_note})${R}"

  # Snapshotted before the repairs below, which report through the same rows.
  local -i noted=$HEALTH_NOTES

  if [[ "$fix" == true ]]; then
    print
    section "  FIXES"

    local applied=0

    if [[ -n "$fix_root" ]]; then
      print -r -- "   ${D}\$ mkdir -p $(tilde "$fix_root")${R}"
      if mkdir -p -- "$fix_root"; then
        health_ok "worktrees" "created $(tilde "$fix_root")"
      else
        health_bad "worktrees" "could not create $(tilde "$fix_root")"
      fi
      (( ++applied ))
    fi

    if [[ "$fix_jq" == true ]]; then
      if command -v brew >/dev/null; then
        print -r -- "   ${D}\$ brew install jq${R}"
        if brew install jq; then
          health_ok "jq" "installed"
        else
          health_bad "jq" "brew install jq did not succeed"
        fi
      else
        health_warn "jq" "Homebrew not found ${D}(install jq yourself)${R}"
      fi
      (( ++applied ))
    fi

    (( applied > 0 )) || hint "   Nothing here can be fixed automatically."
  elif [[ -n "$fix_root" || "$fix_jq" == true ]]; then
    print
    hint "  Some of this can be repaired for you: swm health --fix"
  fi

  print
  if (( HEALTH_PROBLEMS > 0 )); then
    fail "${HEALTH_PROBLEMS} required check(s) failed."
    print -u2
    return 1
  fi

  ok "Ready to use"
  if (( noted > 0 )); then
    hint "  ${noted} optional item(s) noted above."
  fi
  print
}

manage_worktrees() {
  local repo_input="${1:-.}"
  local repo=""

  if ! repo="$(git -C "$repo_input" rev-parse --show-toplevel 2>/dev/null)"; then
    print -u2 "swm manage must run inside a Git repository, or receive one:"
    print -u2 "  swm manage /path/to/repository"
    return 1
  fi

  solo status >/dev/null

  local projects=""
  if ! projects="$(solo_projects)"; then
    fail "Could not list Solo projects."
    return 1
  fi

  # with_spinner runs its command in a background job, so the rows have to come
  # back as output rather than through a variable the job cannot export.
  local pr_rows=""
  if with_spinner "Checking pull requests…" pull_request_rows "$repo"; then
    pr_rows="$SPIN_OUTPUT"
  fi

  local worktree_root="$(default_worktree_root)"
  local canonical_root="${worktree_root:A}"
  local -a worktree_paths worktree_heads worktree_branches worktree_kinds
  local -a worktree_in_solo worktree_pr_state worktree_pr_number worktree_pr_url
  worktree_paths=()
  worktree_heads=()
  worktree_branches=()
  worktree_kinds=()
  worktree_in_solo=()
  worktree_pr_state=()
  worktree_pr_number=()
  worktree_pr_url=()

  local token=""
  local current_path=""
  local current_head=""
  local current_branch=""

  while IFS= read -r -d $'\0' token; do
    case "$token" in
      "worktree "*)
        current_path="${token#worktree }"
        ;;
      "HEAD "*)
        current_head="${token#HEAD }"
        ;;
      "branch refs/heads/"*)
        current_branch="${token#branch refs/heads/}"
        ;;
      "detached")
        current_branch="(detached)"
        ;;
      "")
        if [[ -n "$current_path" ]]; then
          worktree_paths+=("${current_path:A}")
          worktree_heads+=("$current_head")
          worktree_branches+=("${current_branch:-"(unknown)"}")
        fi
        current_path=""
        current_head=""
        current_branch=""
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain -z)

  if (( ${#worktree_paths} == 0 )); then
    fail "No worktrees found."
    return 1
  fi

  local main_path="${worktree_paths[1]}"
  local index=0
  local actual_path=""
  local kind=""
  local solo_label=""
  local short_head=""

  local kind_color=""
  local solo_mark=""

  banner || true

  print
  print -r -- "  ${B}${main_path:t}${R} ${D}${DOT}${R} ${D}${#worktree_paths} worktree(s)${R}"
  print
  if [[ -n "$pr_rows" ]]; then
    printf "  %s%2s  %-28s  %-9s  %-4s  %-7s  %s%s\n" \
      "$D" "#" "BRANCH" "TYPE" "SOLO" "PR" "PATH" "$R"
  else
    printf "  %s%2s  %-28s  %-9s  %-4s  %s%s\n" \
      "$D" "#" "BRANCH" "TYPE" "SOLO" "PATH" "$R"
  fi

  for (( index = 1; index <= ${#worktree_paths}; ++index )); do
    actual_path="${worktree_paths[$index]}"

    if [[ "$actual_path" == "$main_path" ]]; then
      kind="main"
    elif [[ "$actual_path" == "$canonical_root"/* ]]; then
      kind="managed"
    else
      kind="external"
    fi
    worktree_kinds+=("$kind")

    if solo_has_project "$projects" "$actual_path"; then
      solo_label="yes"
    else
      solo_label="no"
    fi
    worktree_in_solo+=("$solo_label")

    short_head="${worktree_heads[$index]:0:8}"
    if [[ "${worktree_branches[$index]}" == "(detached)" ]]; then
      worktree_branches[$index]="detached@$short_head"
    fi

    case "$kind" in
      main)    kind_color="$MAG" ;;
      managed) kind_color="$GRN" ;;
      *)       kind_color="$YLW" ;;
    esac

    if [[ "$solo_label" == "yes" ]]; then
      solo_mark="${GRN}${MARK_OK}${R}"
    else
      solo_mark="${YLW}${MARK_BAD}${R}"
    fi

    local pr_entry="" pr_state="" pr_number="" pr_url=""
    local pr_label="" pr_color="" pr_rest=""
    if pr_entry="$(pull_request_for "$pr_rows" "${worktree_branches[$index]}")"; then
      pr_state="${pr_entry%%$'\t'*}"
      pr_rest="${pr_entry#*$'\t'}"
      pr_number="${pr_rest%%$'\t'*}"
      pr_url="${pr_rest#*$'\t'}"
      local pr_style=""
      pr_style="$(pull_request_style "$pr_state")"
      pr_label="${pr_style%%$'\t'*}"
      pr_color="${pr_style##*$'\t'}"
    else
      pr_label="-"
      pr_color="$D"
    fi
    worktree_pr_state+=("$pr_state")
    worktree_pr_number+=("$pr_number")
    worktree_pr_url+=("$pr_url")

    # Padded to the column width before linking, so the escape sequences never
    # take part in the alignment printf would otherwise measure.
    local pr_cell=""
    pr_cell="$(hyperlink "$pr_url" "${(r:7:)pr_label}")"

    # Colour codes stay in their own printf arguments so the %-Ns widths are
    # measured against the plain text and the columns still line up.
    if [[ -n "$pr_rows" ]]; then
      printf "  %s%2d%s  %s%-28s%s  %s%-9s%s  %s     %s%s%s  %s%s%s\n" \
        "$D" "$index" "$R" \
        "$B" "${worktree_branches[$index]}" "$R" \
        "$kind_color" "$kind" "$R" \
        "$solo_mark" \
        "$pr_color" "$pr_cell" "$R" \
        "$D" "$(tilde "$actual_path")" "$R"
    else
      printf "  %s%2d%s  %s%-28s%s  %s%-9s%s  %s     %s%s%s\n" \
        "$D" "$index" "$R" \
        "$B" "${worktree_branches[$index]}" "$R" \
        "$kind_color" "$kind" "$R" \
        "$solo_mark" \
        "$D" "$(tilde "$actual_path")" "$R"
    fi
  done

  local -a missing_from_solo
  missing_from_solo=("${(@)worktree_in_solo:#yes}")

  print
  if (( ${#missing_from_solo} > 0 )); then
    print -r -- "  ${YLW}${MARK_BAD}${R} ${D}${#missing_from_solo} not in Solo ${EM} select one to add it${R}"
    print
  fi

  # The whole point of the PR column is spotting finished work, so say how much
  # of it there is instead of making it something to scan for.
  if [[ -n "$pr_rows" ]]; then
    local -i merged_count=0
    local -i scan=0
    for (( scan = 1; scan <= ${#worktree_paths}; ++scan )); do
      # A merged PR on the main worktree's branch is routine and says nothing
      # about removing anything, so it must not be counted as finished work.
      [[ "${worktree_kinds[$scan]}" != "main" ]] || continue
      [[ "${worktree_pr_state[$scan]:-}" == "MERGED" ]] || continue
      (( ++merged_count ))
    done

    if (( merged_count > 0 )); then
      print -r -- "  ${MAG}${MARK_OK}${R} ${D}${merged_count} merged ${EM} done with, safe to remove${R}"
      print
    fi
  fi

  local selection=""
  read "selection?  ${B}Select${R} ${D}[1-${#worktree_paths}, n=new, q]${R} " \
    || selection=""
  if [[ "${selection:l}" == "q" || -z "$selection" ]]; then
    hint "  Cancelled."
    return 0
  fi

  if [[ "${selection:l}" == "n" || "${selection:l}" == "new" ]]; then
    print
    # This run already reported any available update.
    SWM_NO_UPDATE_CHECK=1 "$SWM_SCRIPT" new "$repo"
    return $?
  fi

  if [[ "$selection" != <-> ]]; then
    fail "Invalid selection: $selection"
    return 2
  fi

  local selected_index=$(( 10#$selection ))
  if (( selected_index < 1 || selected_index > ${#worktree_paths} )); then
    fail "Selection is out of range: $selection"
    return 2
  fi

  local selected_path="${worktree_paths[$selected_index]}"
  local selected_head="${worktree_heads[$selected_index]}"
  local selected_branch="${worktree_branches[$selected_index]}"
  local selected_kind="${worktree_kinds[$selected_index]}"
  local selected_in_solo="${worktree_in_solo[$selected_index]}"

  print
  info "$selected_branch"
  field "Path" "$(tilde "$selected_path")"
  field "Type" "$selected_kind"
  if [[ "$selected_in_solo" == "yes" ]]; then
    field "Solo" "${GRN}${MARK_OK}${R} yes"
  else
    field "Solo" "${YLW}${MARK_BAD}${R} no"
  fi
  local selected_pr_state="${worktree_pr_state[$selected_index]:-}"
  if [[ -n "$selected_pr_state" ]]; then
    local selected_style=""
    selected_style="$(pull_request_style "$selected_pr_state")"
    local selected_pr_url="${worktree_pr_url[$selected_index]:-}"
    local selected_pr_text=""
    selected_pr_text="#${worktree_pr_number[$selected_index]} ${selected_style%%$'\t'*}"
    field "PR" "${selected_style##*$'\t'}$(hyperlink "$selected_pr_url" "$selected_pr_text")${R}"
    # The URL is worth showing plainly too: not every terminal makes links
    # clickable, and it is the thing you would copy when one does not.
    if [[ -z "$LINKS" && -n "$selected_pr_url" ]]; then
      field "" "${D}${selected_pr_url}${R}"
    fi
  fi
  print
  local action=""
  local choices="f/r/q"
  print -r -- "  ${D}f${R}  fork into a new worktree"
  if [[ "$selected_in_solo" == "no" ]]; then
    print -r -- "  ${D}a${R}  add to Solo"
    choices="f/a/r/q"
  fi
  if [[ "$selected_kind" == "managed" ]]; then
    print -r -- "  ${D}r${R}  remove worktree and Solo project"
  else
    print -r -- "  ${D}r${R}  remove from Solo only"
  fi
  print -r -- "  ${D}q${R}  quit"
  print
  read "action?  ${B}Action${R} ${D}[${choices}]${R} " || action=""

  case "${action:l}" in
    f|fork)
      local new_name=""
      read "new_name?  ${B}New worktree / branch name${R} " || new_name=""
      if [[ -z "$new_name" ]]; then
        fail "A new worktree name is required."
        return 2
      fi

      local -a create_command
      create_command=("$new_name" "$selected_head" "$selected_path")

      if [[ -f "$selected_path/.env" ]]; then
        local remembered=""

        if remembered="$(project_default "$main_path" "fork-env")"; then
          if [[ "$remembered" == "yes" ]]; then
            create_command+=("--with-env")
            hint "  Copying .env (remembered for ${main_path:t}) ${EM} undo: swm forget"
          else
            create_command+=("--no-env")
            hint "  Not copying .env (remembered for ${main_path:t}) ${EM} undo: swm forget"
          fi
        else
          local copy_env=""
          local wants_env="no"
          read "copy_env?  ${B}Copy .env into the new worktree?${R} ${D}[y/N]${R} " \
            || copy_env=""
          if [[ "${copy_env:l}" == "y" || "${copy_env:l}" == "yes" ]]; then
            create_command+=("--with-env")
            wants_env="yes"
          else
            # Explicit, so the child create does not ask the same question.
            create_command+=("--no-env")
          fi

          local remember=""
          read "remember?  ${B}Remember this for ${main_path:t}?${R} ${D}[y/N]${R} " \
            || remember=""
          if [[ "${remember:l}" == "y" || "${remember:l}" == "yes" ]]; then
            if set_project_default "$main_path" "fork-env" "$wants_env"; then
              hint "  Saved ${EM} undo: swm forget"
            else
              print -u2 "Warning: could not save to $(project_defaults_file)"
            fi
          fi
        fi
      fi

      print
      # Re-invoke this exact script, not whatever swm is on PATH, so a
      # different installed version cannot receive flags it does not know.
      local swm_executable="$SWM_SCRIPT"
      # This run already reported any available update.
      SWM_NO_UPDATE_CHECK=1 "$swm_executable" "${create_command[@]}"
      ;;
    a|add)
      if [[ "$selected_in_solo" == "yes" ]]; then
        print -u2 "This worktree is already a Solo project."
        return 1
      fi

      add_to_solo "$selected_path"
      ;;
    r|remove)
      # Worktrees outside SWM_ROOT are not swm's to delete, but their Solo
      # project still is. Offer to unregister without touching anything on disk.
      if [[ "$selected_kind" != "managed" ]]; then
        print "This '$selected_kind' worktree is not under $canonical_root,"
        print "so swm will not delete its directory or Git worktree."

        if [[ "$selected_in_solo" != "yes" ]]; then
          print "It is not a Solo project either, so there is nothing to remove."
          return 1
        fi

        local project_id=""
        local lookup_status=0
        project_id="$(solo_project_id_for "$projects" "$selected_path")" \
          || lookup_status=$?
        if (( lookup_status != 0 )); then
          print -u2 "Could not identify the Solo project for this worktree."
          return 1
        fi

        print
        local unregister=""
        read "unregister?  ${B}Remove its Solo project only?${R} ${D}[y/N, files kept]${R} " \
          || unregister=""
        if [[ "${unregister:l}" != "y" && "${unregister:l}" != "yes" ]]; then
          hint "  Cancelled."
          return 0
        fi

        local delete_output=""
        if ! delete_output="$(
          solo projects delete "$project_id" --confirm-stop-running 2>&1
        )"; then
          print -u2 -r -- "$delete_output"
          fail "Could not remove the Solo project."
          return 1
        fi

        print
        ok "Removed from Solo"
        print
        field "Project" "$project_id"
        field "Path" "$(tilde "$selected_path")"
        field "Kept" "directory, Git worktree, and branch"
        print
        return 0
      fi

      remove_worktree "${selected_path:t}" ""
      ;;
    q|quit|"")
      hint "  Cancelled."
      ;;
    *)
      print -u2 "Unknown action: $action"
      return 2
      ;;
  esac
}

if [[ "${1:-}" == "version" || "${1:-}" == "-v" || "${1:-}" == "--version" ]]; then
  print -r -- "swm $SWM_VERSION"
  exit 0
fi

if [[ "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  help_page
  exit 0
fi

# Dispatched before the update check so a broken install can still be
# diagnosed without waiting on anything.
if [[ "${1:-}" == "health" || "${1:-}" == "doctor" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm health [--fix]"
    exit 2
  fi
  health_check "${2:-}"
  exit $?
fi

if [[ "${1:-}" == "update" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm update [--force]"
    exit 2
  fi
  update_swm "${2:-}"
  exit $?
fi

check_for_update

if (( $# == 0 )); then
  manage_worktrees "."
  exit $?
fi

if [[ "${1:-}" == "manage" ]]; then
  if [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
    help_page
    exit 0
  fi
  if (( $# > 2 )); then
    print -u2 "Usage: swm manage [repository]"
    exit 2
  fi
  manage_worktrees "${2:-.}"
  exit $?
fi

if [[ "${1:-}" == "add" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm add [path]"
    exit 2
  fi
  add_to_solo "${2:-.}"
  exit $?
fi

if [[ "${1:-}" == "forget" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm forget [repository]"
    exit 2
  fi
  forget_project_defaults "${2:-.}"
  exit $?
fi

if [[ "${1:-}" == "remove" || "${1:-}" == "rm" ]]; then
  if (( $# > 3 )); then
    print -u2 "Usage: swm remove <worktree-name> [--yes]"
    exit 2
  fi
  remove_worktree "${2:-}" "${3:-}"
  exit $?
fi

# "swm new [repository]" is creation with nothing supplied up front. Blanking
# the name and branch lets the normal create path below prompt for them, so the
# interactive flow has no separate implementation to keep in step.
if [[ "${1:-}" == "new" ]]; then
  if (( $# > 2 )); then
    print -u2 "Usage: swm new [repository]"
    exit 2
  fi
  set -- "" "" "${2:-.}"
fi

with_env=false
without_env=false
typeset -a create_args
create_args=()

for arg in "$@"; do
  case "$arg" in
    --with-env)
      with_env=true
      ;;
    --no-env)
      without_env=true
      ;;
    -*)
      fail "Unknown option: $arg"
      usage
      exit 2
      ;;
    *)
      create_args+=("$arg")
      ;;
  esac
done

if [[ "$with_env" == true && "$without_env" == true ]]; then
  print -u2 -- "--with-env and --no-env cannot be combined."
  exit 2
fi

if (( ${#create_args} > 3 )); then
  usage
  exit 2
fi

worktree_name="${create_args[1]:-}"
branch_from="${create_args[2]:-}"
repo_input="${create_args[3]:-.}"

repo="$(git -C "$repo_input" rev-parse --show-toplevel)"

source_env="${repo}/.env"

default_branch_from="$(
  git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD \
    2>/dev/null | sed 's#^origin/##' || true
)"
default_branch_from="${default_branch_from:-HEAD}"

if [[ -z "$worktree_name" ]]; then
  read "worktree_name?  ${B}Worktree / branch name${R} " || worktree_name=""
fi

if [[ -z "$worktree_name" ]]; then
  fail "A worktree name is required."
  exit 2
fi

# The requested worktree name is also the branch name, whether it is being
# created or checked out, so it has to be a legal one either way.
new_branch="$worktree_name"
git -C "$repo" check-ref-format --branch "$new_branch" >/dev/null

# A name that already refers to a branch is checked out into a new worktree
# rather than refused. Refusing would send you to git for the exact thing swm
# exists to do, and there is nothing to create in that case anyway.
existing_branch=""
if git -C "$repo" show-ref --verify --quiet "refs/heads/$new_branch"; then
  existing_branch="local"
elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$new_branch"; then
  existing_branch="remote"
elif git -C "$repo" remote get-url origin >/dev/null 2>&1; then
  # The branch may exist on the remote without a local ref for it yet, which is
  # exactly the case where you would want swm to pull it down.
  if with_spinner "Looking for '$new_branch' on origin…" \
    git -C "$repo" ls-remote --exit-code --heads origin "refs/heads/$new_branch"; then
    existing_branch="remote-unfetched"
  fi
fi

# A lone bare word is usually a mistyped subcommand, and creating from one
# would leave a new branch behind. A word that names a branch which already
# exists is not a guess, so only the unrecognised case is refused.
if [[ -z "$existing_branch" ]] \
  && (( ${#create_args} == 1 )) && [[ -n "${create_args[1]}" ]]; then
  fail "Unknown command: ${create_args[1]}"
  print -u2 "  To create a worktree:  swm new"
  print -u2 "  Or name the branch:    swm ${create_args[1]} <branch-from>"
  print -u2 "  Every command:         swm help"
  exit 2
fi

if [[ -n "$existing_branch" ]]; then
  # Checking out a branch that exists needs no start point: the branch is the
  # start point. Passing one anyway asks for two different things at once.
  if [[ -n "$branch_from" ]]; then
    fail "Branch already exists: $new_branch"
    # The repository is the third argument, so a path here is a slot mistake
    # rather than someone genuinely asking to branch from a directory.
    if [[ -d "$branch_from" ]]; then
      detail "'$branch_from' looks like a repository, which is the third argument."
      detail "Check the branch out with: swm $new_branch '' $branch_from"
    else
      detail "It cannot also be created from '$branch_from'."
      detail "Drop the branch-from to check the existing branch out: swm $new_branch"
    fi
    exit 1
  fi

  # git allows one branch in one worktree at a time, so say which one has it
  # rather than letting git's wording land without the path.
  checked_out_at=""
  checked_out_at="$(
    git -C "$repo" worktree list --porcelain \
      | awk -v b="refs/heads/$new_branch" '
          /^worktree /  { path = substr($0, 10) }
          $0 == "branch " b { print path; exit }
        '
  )"
  if [[ -n "$checked_out_at" ]]; then
    fail "Branch '$new_branch' is already checked out at:"
    detail "$(tilde "$checked_out_at")"
    exit 1
  fi

  case "$existing_branch" in
    local)  existing_where="a local branch" ;;
    *)      existing_where="a branch on origin" ;;
  esac

  print
  info "$new_branch is ${existing_where}"
  if [[ -t 0 ]]; then
    confirm_checkout=""
    read "confirm_checkout?  ${B}Check it out as a new worktree?${R} ${D}[Y/n]${R} " \
      || confirm_checkout=""
    if [[ -n "$confirm_checkout" && "${confirm_checkout:l}" != "y" \
      && "${confirm_checkout:l}" != "yes" ]]; then
      hint "  Cancelled."
      exit 0
    fi
  fi
else
  if [[ -z "$branch_from" ]]; then
    read "branch_from?  ${B}Branch from${R} ${D}[$default_branch_from]${R} " || branch_from=""
    branch_from="${branch_from:-$default_branch_from}"
  fi

  if [[ -z "$branch_from" ]]; then
    fail "A branch-from value is required to create a new branch."
    exit 2
  fi
fi

# Herd derives the local hostname from the immediate directory name.
site_name="$(site_slug "$worktree_name")"

if [[ -z "$site_name" ]]; then
  fail "The worktree name has no characters usable in a folder name: $worktree_name"
  detail "Use letters, digits, or dashes."
  exit 1
fi

# The branch keeps the full name; only the folder and hostname are capped, so
# say which one moved rather than letting the summary look like a typo.
site_name_shortened=false
if [[ "$site_name" != "$(raw_slug "$worktree_name")" ]]; then
  site_name_shortened=true
  hint "Folder name shortened to the ${SITE_NAME_LIMIT}-character DNS limit; the branch keeps its full name."
fi

worktree_root="$(default_worktree_root)"
worktree_path="${worktree_root}/${site_name}"

if [[ -e "$worktree_path" ]]; then
  fail "Destination already exists: $worktree_path"
  # Two names that differ only past the cut share a folder, which looks like a
  # phantom clash until you know the name was shortened.
  if [[ "$site_name_shortened" == true ]]; then
    detail "The shortened folder name collides with an existing worktree."
    detail "Make the first ${SITE_NAME_LIMIT} characters of the name distinct."
  fi
  exit 1
fi

start_point=""

if [[ -n "$existing_branch" ]]; then
  # Bring the branch down when only the remote has it, so the worktree can be
  # created from a ref that exists locally.
  if [[ "$existing_branch" == "remote-unfetched" ]]; then
    if ! with_spinner "Fetching origin/$new_branch…" \
      git -C "$repo" fetch --quiet origin \
        "refs/heads/${new_branch}:refs/remotes/origin/${new_branch}"; then
      print -u2 -r -- "$SPIN_OUTPUT"
      fail "Could not fetch origin/$new_branch"
      exit 1
    fi
    existing_branch="remote"
  elif [[ "$existing_branch" == "remote" ]] \
    && git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    # Already had the ref, so this only refreshes it; a stale one still works.
    with_spinner "Refreshing origin/$new_branch…" \
      git -C "$repo" fetch --quiet origin \
        "refs/heads/${new_branch}:refs/remotes/origin/${new_branch}" || true
  fi

  if [[ "$existing_branch" == "local" ]]; then
    start_point="$new_branch"
  else
    start_point="origin/$new_branch"
  fi
else
  # Refresh simple origin branch names so "dev" and "main" use the latest
  # remote-tracking commit. If fetching is unavailable, fall back to the cached
  # ref and say so.
  if [[ "$branch_from" != */* ]] \
    && [[ ! "$branch_from" =~ ^[0-9a-fA-F]{7,64}$ ]] \
    && git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    print "Refreshing origin/$branch_from…"
    if ! git -C "$repo" fetch --quiet origin "$branch_from"; then
      print -u2 "Warning: fetch failed; using the currently available ref."
    fi
  fi

  # Prefer a named remote branch when both origin/dev and a local dev exist.
  # Explicit refs such as origin/dev, tags, and commit SHAs are used as written.
  if [[ "$branch_from" != */* ]] \
    && git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch_from"; then
    start_point="origin/$branch_from"
  elif git -C "$repo" rev-parse --verify --quiet "${branch_from}^{commit}" >/dev/null; then
    start_point="$branch_from"
  elif git -C "$repo" rev-parse --verify --quiet "origin/${branch_from}^{commit}" >/dev/null; then
    start_point="origin/$branch_from"
  else
    fail "Cannot find branch-from ref: $branch_from"
    detail "Try git fetch first, or pass an explicit ref such as origin/main."
    exit 1
  fi
fi

# Check Solo before changing the repository so a disabled API cannot leave a
# newly created worktree waiting to be imported.
solo status >/dev/null

mkdir -p -- "$worktree_root"
canonical_root="${worktree_root:A}"

# Herd is optional. Without it, the worktree is still created and imported into
# Solo; only the local site URL and parked-path handling are skipped.
site_url=""
if has_herd; then
  if ! command -v jq >/dev/null; then
    print -u2 "jq is required to verify Laravel Herd's parked paths."
    exit 1
  fi

  tld="$(herd tld)"
  site_url="http://${site_name}.${tld}"

  # Keep custom SWM_ROOT locations working by parking them once when necessary.
  if ! herd_path_is_parked "$canonical_root"; then
    hint "Parking $(tilde "$canonical_root") with Herd…"
    herd park "$canonical_root" >/dev/null
  fi
fi

# Asked only once the name, branch, and destination are all known to be good,
# so a rejected branch name never costs the user a round of questions first.
if [[ "$with_env" == false && "$without_env" == false && -f "$source_env" ]]; then
  project_key=""
  if project_key="$(main_worktree_path "$repo")"; then
    remembered_env=""
    if remembered_env="$(project_default "$project_key" "fork-env")"; then
      if [[ "$remembered_env" == "yes" ]]; then
        with_env=true
        hint "  Copying .env (remembered for ${project_key:t}) ${EM} undo: swm forget"
      else
        hint "  Not copying .env (remembered for ${project_key:t}) ${EM} undo: swm forget"
      fi
    elif [[ -t 0 ]]; then
      copy_env=""
      wants_env="no"
      # A closed stdin answers No rather than aborting the run.
      read "copy_env?  ${B}Copy .env into the new worktree?${R} ${D}[y/N]${R} " \
        || copy_env=""
      if [[ "${copy_env:l}" == "y" || "${copy_env:l}" == "yes" ]]; then
        with_env=true
        wants_env="yes"
      fi

      remember=""
      read "remember?  ${B}Remember this for ${project_key:t}?${R} ${D}[y/N]${R} " \
        || remember=""
      if [[ "${remember:l}" == "y" || "${remember:l}" == "yes" ]]; then
        if set_project_default "$project_key" "fork-env" "$wants_env"; then
          hint "  Saved ${EM} undo: swm forget"
        else
          fail "Could not save to $(project_defaults_file)"
        fi
      fi
    fi
  fi
fi

if [[ "$with_env" == true ]]; then
  if [[ ! -f "$source_env" || ! -r "$source_env" ]]; then
    fail "Cannot copy .env because the source is missing or unreadable:"
    detail "$source_env"
    exit 1
  fi

  if git -C "$repo" ls-files --error-unmatch .env >/dev/null 2>&1; then
    fail "Refusing to copy .env because it is tracked by Git."
    detail "This is intended for ignored, machine-local Laravel .env files."
    exit 1
  fi

  if ! git -C "$repo" check-ignore -q -- .env; then
    fail "Refusing to copy .env because it is not ignored by Git."
    detail "Add .env to the repository's .gitignore first."
    exit 1
  fi
fi

if [[ "$existing_branch" == "local" ]]; then
  hint "Checking out existing branch '$new_branch'…"
  git -C "$repo" worktree add -q "$worktree_path" "$new_branch"
elif [[ -n "$existing_branch" ]]; then
  # --track makes the new local branch follow origin/<name>, so pushing and
  # pulling work without naming the upstream by hand afterwards.
  hint "Checking out '$start_point' as '$new_branch'…"
  git -C "$repo" worktree add -q --track -b "$new_branch" "$worktree_path" "$start_point"
else
  hint "Creating branch '$new_branch' from '$start_point'…"
  git -C "$repo" worktree add -q -b "$new_branch" "$worktree_path" "$start_point"
fi

if [[ "$with_env" == true ]]; then
  destination_env="${worktree_path}/.env"

  if ! git -C "$worktree_path" check-ignore -q -- .env; then
    print -u2 "Worktree created, but its target branch does not ignore .env."
    print -u2 "No environment file was copied and the project was not added to Solo."
    print -u2 "Clean up with: swm remove '$worktree_name'"
    exit 1
  fi

  if [[ -e "$destination_env" ]]; then
    print -u2 "Worktree created, but its .env already exists; it was not overwritten:"
    detail "$destination_env"
    exit 1
  fi

  # command bypasses any shell function named cp without assuming /bin/cp.
  command cp -p "$source_env" "$destination_env"
  set_env_value "$destination_env" "APP_NAME" "\"${site_name}\""

  # Without Herd there is no generated local URL, so the copied APP_URL is left
  # as-is rather than pointed at a host that does not resolve.
  if [[ -n "$site_url" ]]; then
    set_env_value "$destination_env" "APP_URL" "$site_url"
  fi
fi

repo_name="$(repository_name "$repo")"
# Solo's own output is captured and only shown when the import fails, so a
# successful run leaves just swm's summary on screen.
solo_output=""
if ! solo_output="$(
  solo projects create "${repo_name}: ${new_branch}" "$worktree_path" 2>&1
)"; then
  print -u2 -r -- "$solo_output"
  fail "Worktree created, but Solo import failed."
  detail "Retry with: solo projects create '${repo_name}: ${new_branch}' '$worktree_path'"
  exit 1
fi

print
if [[ -n "$existing_branch" ]]; then
  ok "Checked out and added to Solo"
else
  ok "Created and added to Solo"
fi
print
field "Branch" "${B}${new_branch}${R}"
if [[ "$existing_branch" == "local" ]]; then
  field "From" "${start_point} ${D}(existing local branch)${R}"
elif [[ -n "$existing_branch" ]]; then
  field "From" "${start_point} ${D}(tracking)${R}"
else
  field "From" "$start_point"
fi
field "Path" "$(tilde "$worktree_path")"
[[ -n "$site_url" ]] && field "URL" "${CYN}${site_url}${R}"
if [[ "$site_name_shortened" == true ]]; then
  field "Folder" "${YLW}shortened${R} to ${SITE_NAME_LIMIT} chars ${D}(branch name is full)${R}"
fi
if [[ "$with_env" == true ]]; then
  if [[ -n "$site_url" ]]; then
    field "Env" "copied; APP_NAME and APP_URL updated"
  else
    field "Env" "copied; APP_NAME updated"
  fi
fi
print
